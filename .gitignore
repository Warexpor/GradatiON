# Built application files
*.apk
*.ap_
*.aab
*.aar
*.so

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
.externalNativeBuild/
.cxx/
local.properties

# Machine-local Gradle overrides (SOCKS proxy, JVM flags, etc.) — never commit
gradle.properties.local

# Android Studio and IntelliJ IDEA files
.idea/
.project
.settings
.iml
*.ipr
*.iws
.idea/workspace.xml
.idea/libraries/
.idea/modules.xml
.idea/runConfigurations/
.idea/gradle.xml
.idea/misc.xml

# Keystore files
*.jks
*.keystore
release.properties

# Log files
*.log

# Misc
captures/
.DS_Store
Thumbs.db
app/release/
!app/src/main/res/drawable/.gitkeep
!app/src/main/res/raw/.gitkeep

# Local test results
/build/test-results/

# Lint results
lint-results.html
lint-results.xml

# CMake
CMakeLists.txt.user

# Android Profiling
*.prof
*.hprof

# Gradle Wrapper
# The `gradle-wrapper.jar` is often committed to ensure consistent Gradle versions.
!gradle/wrapper/gradle-wrapper.jar

# Other common files to ignore
.vscode/

# Local APK extract / decompile dumps (not product source)
references/
tools/

# Agent / UI-automation scratch (adb dumps, screenshot experiments)
.tmp_*
/ui.xml
/ui2.xml
/ui*.xml
/history_*.png
/history_current.png
/alpha_*.png
/chip*.png
/model_*.png
/picker*.png
/screen_*.png
/tick*.png
/verify_*.png
/other_chips.png
/model_chip_fix.png
.tmp_mat/

# Cursor / IDE session artifacts (if ever created inside the repo)
.cursor/

# Env and secrets
.env
.env.*
*.pem
secrets/

# Kotlin daemon / incremental compiler local state
.kotlin/
