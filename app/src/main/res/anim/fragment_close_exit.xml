<?xml version="1.0" encoding="utf-8"?>
<!-- iOS navigation push/pop: top screen slides off to the right -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="true"
    android:interpolator="@interpolator/ios_push">
    <translate
        android:duration="@integer/motion_fragment_close"
        android:fromXDelta="0"
        android:toXDelta="100%p" />
    <alpha
        android:duration="@integer/motion_fragment_close"
        android:fromAlpha="1"
        android:toAlpha="1" />
</set>
