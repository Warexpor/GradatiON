<?xml version="1.0" encoding="utf-8"?>
<!-- iOS navigation push/pop: previous screen drifts back into place -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="true"
    android:interpolator="@interpolator/ios_push">
    <translate
        android:duration="@integer/motion_fragment_close"
        android:fromXDelta="-30%p"
        android:toXDelta="0" />
    <alpha
        android:duration="@integer/motion_fragment_close"
        android:fromAlpha="0.7"
        android:toAlpha="1" />
</set>
