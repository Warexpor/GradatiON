<?xml version="1.0" encoding="utf-8"?>
<!-- Code home: glass find field when there are sessions to filter -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <EditText
        android:id="@+id/codeHomeSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_history_search_pill"
        android:drawableStart="@drawable/ic_search_stroke"
        android:drawablePadding="10dp"
        android:drawableTint="@color/xai_mute"
        android:ellipsize="end"
        android:hint="@string/code_home_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/xai_ink"
        android:textColorHint="@color/xai_mute"
        android:textSize="15sp" />
</FrameLayout>
