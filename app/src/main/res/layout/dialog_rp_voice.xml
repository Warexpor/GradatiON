<?xml version="1.0" encoding="utf-8"?>
<!-- RP character voice: which system voice reads this character aloud, and how high and fast -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_dialog_bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/rpVoiceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Gradation.Headline" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/rp_voice_hint"
        android:textColor="@color/xai_mute"
        android:textSize="13sp" />

    <io.github.stardomains3.oxproxion.MaxHeightScrollView
        android:id="@+id/rpVoiceScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">

        <LinearLayout
            android:id="@+id/rpVoiceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </io.github.stardomains3.oxproxion.MaxHeightScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/rp_voice_pitch"
            android:textColor="@color/xai_ink"
            android:textSize="15sp" />

        <io.github.stardomains3.oxproxion.GlassSegmentedGroup
            android:id="@+id/rpVoicePitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rpPitchLow"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rp_voice_low"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rpPitchMid"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rp_voice_normal"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rpPitchHigh"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rp_voice_high"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline" />
        </io.github.stardomains3.oxproxion.GlassSegmentedGroup>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/rp_voice_speed"
            android:textColor="@color/xai_ink"
            android:textSize="15sp" />

        <io.github.stardomains3.oxproxion.GlassSegmentedGroup
            android:id="@+id/rpVoiceRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rpRateSlow"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rp_voice_slow"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rpRateMid"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rp_voice_normal"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rpRateFast"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rp_voice_fast"
                app:backgroundTint="@color/toggle_background_selector"
                app:strokeColor="@color/xai_hairline" />
        </io.github.stardomains3.oxproxion.GlassSegmentedGroup>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rpVoiceCancel"
            style="@style/Widget.Gradation.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/edit_response_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rpVoiceSave"
            style="@style/Widget.Grokion.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/rp_memory_save" />
    </LinearLayout>
</LinearLayout>
