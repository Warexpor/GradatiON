<?xml version="1.0" encoding="utf-8"?>
<!-- Code transcript: the agent's live plan (one card per session, updates in place). A glass card
     the rail stops at; each step's status glyph lands on the rail column. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/code_card_inset"
    android:paddingEnd="@dimen/code_card_inset"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Each step row carries 6dp above and below, so the rows sit 12dp apart and the card's own
         pads finish the same air above the label and below the last step. The label sits flush on
         the first row's 6dp, nearer its steps than they are to each other, so it heads them
         instead of floating halfway between the card's edge and the list. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_code_card"
        android:orientation="vertical"
        android:paddingStart="@dimen/code_card_glyph_pad"
        android:paddingEnd="@dimen/code_card_pad"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/code_text_indent"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <!-- viewStart: in an RTL locale an English label would align by its own text and run
                 into the count -->
            <TextView
                android:id="@+id/codePlanTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/code_session_plan"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.Gradation.SectionHeader" />

            <TextView
                android:id="@+id/codePlanProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Gradation.Code.MonoLine"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Steps inflate item_code_plan_step -->
        <LinearLayout
            android:id="@+id/codePlanRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
