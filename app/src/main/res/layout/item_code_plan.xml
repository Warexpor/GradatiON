<?xml version="1.0" encoding="utf-8"?>
<!-- Code transcript: the agent's live plan (one card per session, updates in place). Opaque, so the
     rail runs behind it; each step's status glyph lands on the rail column. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="14dp"
    android:paddingTop="4dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_code_card"
        android:orientation="vertical"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/codePlanTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/code_session_plan"
                android:textAppearance="@style/TextAppearance.Gradation.SectionHeader" />

            <TextView
                android:id="@+id/codePlanProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Gradation.Code.Mono"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 1dp start pad centres the 18dp status glyphs on the rail column -->
        <LinearLayout
            android:id="@+id/codePlanRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="1dp" />
    </LinearLayout>
</FrameLayout>
