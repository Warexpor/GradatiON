<?xml version="1.0" encoding="utf-8"?>
<!-- Empty library (characters, lorebooks): icon, what it is for, and the two ways to fill it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingEnd="40dp"
    android:paddingBottom="48dp">

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_model_icon_circle">

        <ImageView
            android:id="@+id/rpEmptyIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            app:tint="@color/xai_mute" />
    </FrameLayout>

    <TextView
        android:id="@+id/rpEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Gradation.Title" />

    <TextView
        android:id="@+id/rpEmptyBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:textAppearance="@style/TextAppearance.Gradation.Footnote"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rpEmptyCreate"
        style="@style/Widget.Grokion.Button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="160dp"
        android:text="@string/rp_ui_empty_create" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rpEmptyImport"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/rp_ui_empty_import" />
</LinearLayout>
