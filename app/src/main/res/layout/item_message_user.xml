<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="40dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/userGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.88"
        app:layout_constraintHorizontal_bias="1.0">

        <!-- Roleplay: your persona's name and portrait over your line, mirroring the
             character's row over theirs. Only when this character has a persona and the
             Layout switch is on. -->
        <LinearLayout
            android:id="@+id/rpUserHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/rpUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="220dp"
                android:textColor="@color/xai_ink"
                android:textSize="13sp"
                android:textFontWeight="600" />

            <FrameLayout
                android:id="@+id/rpUserAvatarFrame"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/rpUserAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/rp_bg_monogram"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/XaiShapePill" />

                <TextView
                    android:id="@+id/rpUserInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/app_sans"
                    android:gravity="center"
                    android:textColor="@color/xai_ink"
                    android:textFontWeight="600"
                    android:textSize="15sp" />
            </FrameLayout>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/messageContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_user_message"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rpUserHeader"
            android:layout_marginTop="6dp"
            app:layout_goneMarginTop="0dp"
            app:layout_constraintHorizontal_bias="1.0">

            <!-- A sent photo: a rounded picture capped in size, never stretched across the bubble. -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/userImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_attached_image"
                android:adjustViewBounds="true"
                android:maxWidth="240dp"
                android:maxHeight="300dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Gradation.Photo"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <io.github.stardomains3.oxproxion.ChatTextView
                android:id="@+id/messageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start|top"
                tools:text="User message here"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.36"
                android:textIsSelectable="false"
                android:linksClickable="true"
                android:textColorLink="@color/xai_link"
                android:textColorHighlight="@color/xai_text_highlight"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="10dp"
                app:layout_goneMarginTop="0dp"
                app:layout_constraintTop_toBottomOf="@id/userImageView" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Always under the bubble. The action row below stays hidden until a tap, so a
             long message could not be opened from there. A label, not a chevron: the
             control has to say what it does. -->
        <TextView
            android:id="@+id/collapseToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="44dp"
            android:gravity="center_vertical|end"
            android:paddingStart="12dp"
            android:paddingEnd="2dp"
            android:background="@drawable/bg_action_press"
            android:contentDescription="@string/cd_show_more"
            android:fontFamily="@font/app_sans"
            android:text="@string/cd_show_more"
            android:textColor="@color/xai_mute"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/messageContainer" />

        <!-- Edit + copy primary (right), then local extras; hidden until tap. Bare icons, no
             capsule, the same row the reply has under it. -->
        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/collapseToggleButton">

            <ImageButton
                android:id="@+id/editButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_edit_message"
                android:padding="7dp"
                android:src="@drawable/ic_msg_edit"
                android:visibility="visible"
                app:tint="@color/xai_mute" />

            <ImageButton
                android:id="@+id/copyButtonuser"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_copy_text"
                android:padding="7dp"
                android:src="@drawable/ic_msg_copy"
                app:tint="@color/xai_mute" />

            <ImageButton
                android:id="@+id/deleteButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_delete_message"
                android:padding="7dp"
                android:src="@drawable/ic_msg_delete"
                android:visibility="visible"
                app:tint="@color/delete_action" />

            <!-- Kept for ID stability; regenerate lives under AI responses now -->
            <ImageButton
                android:id="@+id/resendButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:contentDescription="@string/rp_regenerate"
                android:src="@drawable/ic_msg_regenerate" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
