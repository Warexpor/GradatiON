<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="40dp"
    android:paddingEnd="6dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/userGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.88"
        app:layout_constraintHorizontal_bias="1.0">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/messageContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_user_message"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="1.0">

            <ImageView
                android:id="@+id/userImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:visibility="gone"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <io.github.stardomains3.oxproxion.ChatTextView
                android:id="@+id/messageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start|top"
                android:text="User message here"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.36"
                android:textIsSelectable="true"
                android:linksClickable="true"
                android:textColorLink="@color/xai_link"
                android:textColorHighlight="@color/xai_text_highlight"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/userImageView" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Grok-style: edit + copy primary (right), then local extras; hidden until tap -->
        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:background="@drawable/bg_chat_actions"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/messageContainer">

            <ImageButton
                android:id="@+id/editButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_edit_message"
                android:padding="8.5dp"
                android:src="@drawable/ic_edit"
                android:visibility="visible"
                app:tint="@color/xai_mute" />

            <ImageButton
                android:id="@+id/copyButtonuser"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_copy_text"
                android:padding="8.5dp"
                android:src="@drawable/ic_copi"
                app:tint="@color/xai_mute" />

            <ImageButton
                android:id="@+id/deleteButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_delete_message"
                android:padding="8.5dp"
                android:src="@drawable/ic_trash"
                android:visibility="visible"
                app:tint="@color/xai_mute" />

            <ImageButton
                android:id="@+id/collapseToggleButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_toggle_expand"
                android:padding="8.5dp"
                android:src="@drawable/ic_expand_more"
                android:visibility="gone"
                app:tint="@color/xai_mute" />

            <!-- Kept for ID stability; regenerate lives under AI responses now -->
            <ImageButton
                android:id="@+id/resendButton"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:contentDescription="@string/rp_regenerate"
                android:src="@drawable/ic_redo" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
