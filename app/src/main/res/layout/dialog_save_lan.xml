<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/rounded_dialog_bg"
        android:minHeight="200dp">

        <TextView
            android:id="@+id/dialog_title_lan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_lan_title"
            android:textColor="@color/xai_ink"
            android:textAppearance="@style/TextAppearance.Gradation.Headline"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_lan_example"
            android:textColor="@color/xai_mute"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <!-- Edit field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/edit_text_lan_url_layout"
            style="@style/Xai.TextInputLayout"
            app:errorIconDrawable="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/save_lan_endpoint_hint"
            app:hintTextColor="@color/xai_mute">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_text_lan_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:imeOptions="actionDone"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Provider Selection Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_lan_select_provider"
            android:textColor="@color/xai_ink"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- Shown when Save is tapped with no server type picked. -->
        <TextView
            android:id="@+id/lan_provider_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/lan_error_pick_server"
            android:textColor="@color/xai_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- One server kind: a radio group, so the choice can't be cleared by tapping it again -->
        <RadioGroup
            android:id="@+id/lan_provider_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/checkbox_ollama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:text="@string/save_lan_ollama"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                app:buttonTint="@color/button_tint" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/checkbox_lm_studio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:text="@string/save_lan_lm_studio"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                app:buttonTint="@color/button_tint" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/checkbox_llama_cpp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:text="@string/save_lan_llama_cpp"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                app:buttonTint="@color/button_tint" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/checkbox_mlx_lm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:text="@string/save_lan_mlx_lm"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                app:buttonTint="@color/button_tint" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/checkbox_hermes_agent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:text="@string/save_lan_hermes_agent"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                app:buttonTint="@color/button_tint" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/checkbox_olmx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:text="@string/save_lan_omlx"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                app:buttonTint="@color/button_tint" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/checkbox_nativ"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:text="@string/save_lan_nativ"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                app:buttonTint="@color/button_tint" />

        </RadioGroup>

        <!-- NEW: LAN API Key Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_lan_api_key_label"
            android:textColor="@color/xai_ink"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/edit_text_lan_api_key_layout"
            style="@style/Xai.TextInputLayout"
            app:errorIconDrawable="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/save_lan_enter_if_required"
            app:hintTextColor="@color/xai_mute"
            android:layout_marginBottom="16dp"
            app:endIconMode="password_toggle"
            app:endIconDrawable="@drawable/ic_password_eye"
            app:endIconTint="@color/xai_mute">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_text_lan_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_cancel_lan"
                style="@style/Widget.Gradation.Button.Tonal"
                android:layout_width="0dp"
            android:layout_weight="1"
                android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
                android:text="@string/action_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_save_lan"
                style="@style/Widget.Grokion.Button"
                android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
                android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
                android:text="@string/action_save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
