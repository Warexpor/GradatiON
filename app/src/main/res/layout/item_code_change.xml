<?xml version="1.0" encoding="utf-8"?>
<!-- One changed file: status letter + ellipsized path -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_press_svg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/codeChangeStatus"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Gradation.Code.Mono"
        android:textColor="@color/xai_ink"
        android:textSize="14sp"
        android:textFontWeight="700" />

    <TextView
        android:id="@+id/codeChangePath"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Gradation.Code.Mono"
        android:textColor="@color/xai_ink"
        android:textSize="14sp" />
</LinearLayout>
