<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <!-- Grok: full-width assistant text, no bubble chrome -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/aiGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="1.0"
        app:layout_constraintHorizontal_bias="0.0">

        <!-- Collapsible reasoning / thinking block (Grok-style) -->
        <LinearLayout
            android:id="@+id/reasoningBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/reasoningHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_reasoning_header"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/reasoningChevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_expand_more"
                    app:tint="@color/xai_mute"
                    android:contentDescription="@string/toggle_reasoning" />

                <TextView
                    android:id="@+id/reasoningTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/thinking_label"
                    android:textColor="@color/xai_mute"
                    android:textSize="13sp"
                    android:textFontWeight="600" />
            </LinearLayout>

            <TextView
                android:id="@+id/reasoningTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:textColor="@color/xai_mute"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.55"
                android:visibility="gone"
                android:textIsSelectable="true" />
        </LinearLayout>

        <!-- Tech-style thinking indicator (shown while awaiting response) -->
        <LinearLayout
            android:id="@+id/thinkingRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginBottom="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/reasoningBlock">

            <LinearLayout
                android:id="@+id/thinkingBars"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginEnd="10dp">

                <View
                    android:id="@+id/thinkingBar1"
                    android:layout_width="2dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_thinking_bar" />

                <View
                    android:id="@+id/thinkingBar2"
                    android:layout_width="2dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_thinking_bar" />

                <View
                    android:id="@+id/thinkingBar3"
                    android:layout_width="2dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_thinking_bar" />
            </LinearLayout>

            <TextView
                android:id="@+id/thinkingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/thinking_label"
                android:textColor="@color/xai_mute"
                android:textSize="14sp"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rpSpeakerHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginBottom="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/thinkingRow">

            <ImageView
                android:id="@+id/rpSpeakerAvatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_model_icon_circle"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:contentDescription="@string/rp_character_avatar"
                android:src="@drawable/ic_gradation_mark" />

            <TextView
                android:id="@+id/rpSpeakerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/xai_ink"
                android:textSize="13sp"
                android:textFontWeight="600" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/messageContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ai_message"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rpSpeakerHeader"
            app:layout_constraintHorizontal_bias="0.0">

            <!-- NEW: ImageView for generated images -->
            <ImageView
                android:id="@+id/generatedImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:maxHeight="300dp"
                android:scaleType="centerInside"
                android:visibility="gone"
                app:layout_constrainedWidth="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <io.github.stardomains3.oxproxion.ChatTextView
                android:id="@+id/messageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start|top"
                android:text="AI message here"
                android:textColor="@color/xai_body"
                android:textColorLink="@color/xai_link"
                android:textColorHighlight="@color/xai_text_highlight"
                android:textIsSelectable="true"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.36"
                android:linksClickable="true"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/generatedImageView" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Action row + fork navigator (Grok-style < n/m > on the right) -->
        <LinearLayout
            android:id="@+id/aiActionRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/messageContainer">

            <!-- Message actions sit in one small glass capsule -->
            <LinearLayout
                android:id="@+id/aiActionButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_actions"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/copyButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_copy_text"
                android:padding="9dp"
                android:src="@drawable/ic_copi"
                app:tint="@color/xai_body" />

            <ImageButton
                android:id="@+id/shareButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_share_text"
                android:padding="9dp"
                android:src="@drawable/ic_share"
                app:tint="@color/xai_body" />

            <ImageButton
                android:id="@+id/ttsButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_speak_text"
                android:padding="9dp"
                android:src="@drawable/ic_volume_up"
                app:tint="@color/xai_body" />

            <ImageButton
                android:id="@+id/instructButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/rp_instruct"
                android:padding="9dp"
                android:src="@drawable/ic_editnote"
                android:visibility="gone"
                app:tint="@color/xai_body" />

            <ImageButton
                android:id="@+id/regenerateButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/rp_regenerate"
                android:padding="9dp"
                android:src="@drawable/ic_redo"
                app:tint="@color/xai_body" />

            <ImageButton
                android:id="@+id/editButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_edit_message"
                android:padding="9dp"
                android:src="@drawable/ic_edit"
                android:visibility="visible"
                app:tint="@color/xai_body" />

            <ImageButton
                android:id="@+id/aipdfButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_make_pdf"
                android:padding="9dp"
                android:src="@drawable/ic_pdfnew"
                android:visibility="gone"
                app:tint="@color/xai_body" />

            <ImageButton
                android:id="@+id/markdownButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_make_md"
                android:padding="9dp"
                android:src="@drawable/ic_markdown"
                android:visibility="gone"
                app:tint="@color/xai_body" />

            <ImageButton
                android:id="@+id/pngButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_make_png"
                android:padding="9dp"
                android:src="@drawable/ic_png"
                android:visibility="gone"
                app:tint="@color/xai_body" />

            <ImageButton
                android:id="@+id/htmlButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_view_html"
                android:padding="9dp"
                android:src="@drawable/ic_html"
                android:visibility="gone"
                app:tint="@color/xai_body" />

            <ImageButton
                android:id="@+id/saveFileButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_save_file"
                android:padding="9dp"
                android:src="@drawable/ic_filesave"
                android:visibility="gone"
                app:tint="@color/xai_body" />

            <ImageButton
                android:id="@+id/collapseToggleButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/cd_toggle_expand"
                android:padding="9dp"
                android:src="@drawable/ic_expand_more"
                android:visibility="visible"
                app:tint="@color/xai_body" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/forkNavigator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:background="@drawable/bg_chat_actions"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:layout_marginStart="8dp">

                <ImageButton
                    android:id="@+id/forkPrev"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_action_press"
                    android:contentDescription="@string/fork_prev"
                    android:padding="6dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/xai_body" />

                <TextView
                    android:id="@+id/forkLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/xai_body"
                    android:textSize="13sp"
                    tools:text="1 / 2" />

                <ImageButton
                    android:id="@+id/forkNext"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_action_press"
                    android:contentDescription="@string/fork_next"
                    android:padding="6dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/xai_body" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
