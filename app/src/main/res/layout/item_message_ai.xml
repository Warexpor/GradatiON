<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <!-- Grok: full-width assistant text, no bubble chrome -->
    <!-- Collapsible reasoning: a quiet "Thinking" line, no chip; opened thoughts hang off a
         hairline rule so they read apart from the answer. -->
    <LinearLayout
        android:id="@+id/reasoningBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/reasoningHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/reasoningTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/thinking_label"
                android:textColor="@color/xai_mute"
                android:textSize="14sp"
                android:textFontWeight="500" />

            <ImageView
                android:id="@+id/reasoningChevron"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_msg_expand"
                app:tint="@color/xai_mute"
                android:contentDescription="@string/toggle_reasoning" />
        </LinearLayout>

        <TextView
            android:id="@+id/reasoningTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_reasoning_rule"
            android:paddingStart="14dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="@color/xai_mute"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.55"
            android:visibility="gone"
            android:textIsSelectable="true" />
    </LinearLayout>

    <!-- Tech-style thinking indicator (shown while awaiting response) -->
    <LinearLayout
        android:id="@+id/thinkingRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginBottom="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reasoningBlock">

        <TextView
            android:id="@+id/thinkingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/thinking_label"
            android:textColor="@color/xai_mute"
            android:textSize="14sp"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rpSpeakerHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/thinkingRow">

        <ImageView
            android:id="@+id/rpSpeakerAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_model_icon_circle"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:contentDescription="@string/rp_character_avatar"
            android:src="@drawable/ic_gradation_mark"
            app:tint="@color/xai_mute" />

        <TextView
            android:id="@+id/rpSpeakerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/xai_ink"
            android:textSize="13sp"
            android:textFontWeight="600" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/messageContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ai_message"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rpSpeakerHeader"
        app:layout_constraintHorizontal_bias="0.0">

        <!-- NEW: ImageView for generated images -->
        <ImageView
            android:id="@+id/generatedImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_generated_image"
            android:layout_margin="4dp"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:maxHeight="300dp"
            android:scaleType="centerInside"
            android:visibility="gone"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <io.github.stardomains3.oxproxion.ChatTextView
            android:id="@+id/messageTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start|top"
            tools:text="AI message here"
            android:textColor="@color/xai_body"
            android:textColorLink="@color/xai_link"
            android:textColorHighlight="@color/xai_text_highlight"
            android:textIsSelectable="true"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.36"
            android:linksClickable="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/generatedImageView" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Action row + fork navigator (Grok-style < n/m > on the right) -->
    <LinearLayout
        android:id="@+id/aiActionRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/messageContainer">

        <!-- Message actions: small bare icons under the message (no capsule); scroll on narrow widths -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipToPadding="true">
        <LinearLayout
            android:id="@+id/aiActionButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <!-- 32dp bare icons (DESIGN.md); the glyph stays 18dp inside them -->
        <ImageButton
            android:id="@+id/copyButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_action_press"
            android:contentDescription="@string/cd_copy_text"
            android:padding="7dp"
            android:src="@drawable/ic_msg_copy"
            app:tint="@color/xai_mute" />

        <ImageButton
            android:visibility="gone"
            android:id="@+id/ttsButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_action_press"
            android:contentDescription="@string/cd_speak_text"
            android:padding="7dp"
            android:src="@drawable/ic_msg_speak"
            app:tint="@color/xai_mute" />

        <ImageButton
            android:id="@+id/instructButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_action_press"
            android:contentDescription="@string/rp_instruct"
            android:padding="7dp"
            android:src="@drawable/ic_msg_instruct"
            android:visibility="gone"
            app:tint="@color/xai_mute" />

        <ImageButton
            android:id="@+id/regenerateButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_action_press"
            android:contentDescription="@string/rp_regenerate"
            android:padding="7dp"
            android:src="@drawable/ic_msg_regenerate"
            app:tint="@color/xai_mute" />

        <!-- Read aloud, Instruct and Edit live in this menu; their buttons stay hidden -->
        <ImageButton
            android:id="@+id/moreActionsButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_action_press"
            android:contentDescription="@string/cd_more_actions"
            android:padding="7dp"
            android:src="@drawable/ic_msg_more"
            app:tint="@color/xai_mute" />

        <ImageButton
            android:id="@+id/editButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_action_press"
            android:contentDescription="@string/cd_edit_message"
            android:padding="7dp"
            android:src="@drawable/ic_msg_edit"
            android:visibility="gone"
            app:tint="@color/xai_mute" />
        </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/forkNavigator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <ImageButton
                android:id="@+id/forkPrev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/fork_prev"
                android:padding="7dp"
                android:src="@drawable/ic_msg_chevron_left"
                app:tint="@color/xai_mute" />

            <TextView
                android:id="@+id/forkLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/xai_body"
                android:textSize="13sp"
                tools:text="1 / 2" />

            <ImageButton
                android:id="@+id/forkNext"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_action_press"
                android:contentDescription="@string/fork_next"
                android:padding="7dp"
                android:src="@drawable/ic_msg_chevron_right"
                app:tint="@color/xai_mute" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
