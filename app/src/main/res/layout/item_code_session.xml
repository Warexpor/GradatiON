<?xml version="1.0" encoding="utf-8"?>
<!-- Code home: one session. The agent's mark is a key that lights while the session works or
     waits on you, then the title, a status chip with where + when, and the agent's last line. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/codeSessionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_code_session_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/bg_press_svg"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:stateListAnimator="@animator/press_scale">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/codeSessionGlyph"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_code_mark_tile"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:tint="@color/xai_ink" />

            <View
                android:id="@+id/codeSessionLed"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/codeSessionRowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
                    android:textFontWeight="600" />

                <TextView
                    android:id="@+id/codeSessionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="1dp"
                    android:drawablePadding="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/app_sans"
                    android:gravity="center"
                    android:maxWidth="140dp"
                    android:maxLines="1"
                    android:minHeight="22dp"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="2dp"
                    android:textSize="13sp"
                    android:textFontWeight="600"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Agent and folder give way before the age does; the age sits at the end -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/codeSessionRowMeta"
                    style="@style/Widget.Gradation.Code.MonoLine"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/codeSessionRowAge"
                    style="@style/Widget.Gradation.Code.MonoLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/codeSessionRowPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_code_preview_rule"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="2"
                android:paddingStart="10dp"
                style="@style/Widget.Gradation.Code.MonoLine"
                android:textColor="@color/xai_body" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
