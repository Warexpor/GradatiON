<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xai_canvas"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/xai_canvas"
            app:navigationIcon="@drawable/is_backarrow"
            app:navigationContentDescription="@string/cd_navigate_up"
            app:navigationIconTint="@color/xai_ink"
            app:title="@string/rp_hub_title"
            app:titleTextColor="@color/xai_ink" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.06"
                android:text="@string/rp_hub_section_library"
                android:textAllCaps="true"
                android:textColor="@color/xai_mute"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rpHubCharactersButton"
                    style="@style/Widget.Grokion.Button.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rp_characters_title"
                    app:icon="@drawable/ic_person" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/xai_hairline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rpHubPersonaButton"
                    style="@style/Widget.Grokion.Button.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rp_persona_title"
                    app:icon="@drawable/ic_person3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/xai_hairline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rpHubLorebooksButton"
                    style="@style/Widget.Grokion.Button.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rp_lorebooks_title"
                    app:icon="@drawable/ic_prompts" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/xai_hairline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rpHubSettingsButton"
                    style="@style/Widget.Grokion.Button.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rp_settings_title"
                    app:icon="@drawable/ic_settings" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.06"
                android:text="@string/rp_hub_section_backup"
                android:textAllCaps="true"
                android:textColor="@color/xai_mute"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rpHubExportCharsButton"
                    style="@style/Widget.Grokion.Button.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rp_export_characters"
                    app:icon="@drawable/ic_export" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/xai_hairline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rpHubImportCharsButton"
                    style="@style/Widget.Grokion.Button.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rp_import_characters"
                    app:icon="@drawable/ic_import" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/xai_hairline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rpHubExportLoreButton"
                    style="@style/Widget.Grokion.Button.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rp_export_lorebooks"
                    app:icon="@drawable/ic_export" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/xai_hairline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rpHubImportLoreButton"
                    style="@style/Widget.Grokion.Button.SettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rp_import_lorebooks"
                    app:icon="@drawable/ic_import" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
