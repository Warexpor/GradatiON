<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xai_grouped"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/xai_grouped"
        app:navigationContentDescription="@string/cd_navigate_up"
        app:navigationIcon="@drawable/is_backarrow"
        app:navigationIconTint="@color/xai_ink"
        app:title="@string/rp_hub_title"
        app:titleTextColor="@color/xai_ink" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/rp_ui_hub_intro"
                android:textAppearance="@style/TextAppearance.Gradation.Footnote"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/rp_bg_card"
                android:clipToOutline="true"
                android:orientation="vertical">

                <include
                    android:id="@+id/rpHubCharactersRow"
                    layout="@layout/item_rp_hub_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/xai_hairline" />

                <include
                    android:id="@+id/rpHubPersonaRow"
                    layout="@layout/item_rp_hub_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/xai_hairline" />

                <include
                    android:id="@+id/rpHubLorebooksRow"
                    layout="@layout/item_rp_hub_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/xai_hairline" />

                <include
                    android:id="@+id/rpHubSettingsRow"
                    layout="@layout/item_rp_hub_row" />
            </LinearLayout>

            <!-- Import and export: plain rows, one card, always visible -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/rp_bg_card"
                android:clipToOutline="true"
                android:orientation="vertical">

                <include
                    android:id="@+id/rpHubImportRow"
                    layout="@layout/item_rp_hub_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/xai_hairline" />

                <include
                    android:id="@+id/rpHubExportCharsRow"
                    layout="@layout/item_rp_hub_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/xai_hairline" />

                <include
                    android:id="@+id/rpHubExportLoreRow"
                    layout="@layout/item_rp_hub_row" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
