<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the message menu: label first, icon on the trailing side. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_message_menu_row"
    android:gravity="center_vertical"
    android:minHeight="46dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/messageMenuLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/app_sans"
        android:singleLine="true"
        android:textColor="@color/xai_ink"
        android:textFontWeight="600"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/messageMenuIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="24dp"
        android:importantForAccessibility="no"
        app:tint="@color/xai_ink" />
</LinearLayout>
