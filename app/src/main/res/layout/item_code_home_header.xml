<?xml version="1.0" encoding="utf-8"?>
<!-- Code home: which machine you're driving (tap to switch), and Code settings -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/codeMachinePill"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:background="@drawable/bg_model_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_code_machine"
            app:tint="@color/xai_ink" />

        <TextView
            android:id="@+id/codeMachineName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxWidth="180dp"
            android:singleLine="true"
            android:textColor="@color/xai_ink"
            android:textSize="15sp"
            android:textFontWeight="600" />

        <View
            android:id="@+id/codeMachineDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_code_dot" />

        <TextView
            android:id="@+id/codeMachineStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:textColor="@color/xai_mute"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_expand_more"
            app:tint="@color/xai_body" />
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/codeHomeSettings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_press_svg"
        android:contentDescription="@string/cd_code_settings"
        android:scaleType="centerInside"
        android:src="@drawable/ic_settings_stroke"
        app:tint="@color/xai_body" />
</LinearLayout>
