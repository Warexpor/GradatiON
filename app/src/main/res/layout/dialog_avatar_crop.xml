<?xml version="1.0" encoding="utf-8"?>
<!-- Avatar crop: move and zoom the photo under a round window, then use it -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xai_grouped"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal"
        android:text="@string/avatar_crop_title"
        android:textColor="@color/xai_ink"
        android:textFontWeight="600"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_horizontal"
        android:text="@string/avatar_crop_hint"
        android:textColor="@color/xai_mute"
        android:textSize="14sp" />

    <io.github.stardomains3.oxproxion.AvatarCropView
        android:id="@+id/avatarCropView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/avatarCropCancel"
            style="@style/Widget.Grokion.Button.Text"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/avatar_crop_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/avatarCropDone"
            style="@style/Widget.Grokion.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/avatar_crop_done" />
    </LinearLayout>
</LinearLayout>
