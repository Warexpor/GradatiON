<?xml version="1.0" encoding="utf-8"?>
<!-- Code transcript: the agent is waiting on you. Collapses to one bead on the rail once answered.
     The row's top and bottom pads are set on bind: a card's air while open, a tool row's once folded. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/code_card_inset"
    android:paddingEnd="@dimen/code_card_inset"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Glass card the rail stops at; the shield lands on the rail column. A lifted card, so a step
         more air than the others. The question and what it is about read as one block; the detail
         and the answers each get a clear step below. -->
    <LinearLayout
        android:id="@+id/codeApprovalCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_code_approval"
        android:orientation="vertical"
        android:paddingStart="@dimen/code_card_glyph_pad"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_code_shield"
                app:tint="@color/xai_ink" />

            <TextView
                android:id="@+id/codeApprovalTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                android:textFontWeight="600" />
        </LinearLayout>

        <TextView
            android:id="@+id/codeApprovalWhat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/code_text_indent"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:textColor="@color/xai_body"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/codeApprovalDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/code_text_indent"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_code_pane"
            android:maxLines="6"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.2"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            style="@style/Widget.Gradation.Code.MonoLine"
            android:textColor="@color/xai_body" />

        <!-- On the content column like the words above; side by side, or stacked when they do not fit -->
        <io.github.stardomains3.oxproxion.code.CodeChoiceRow
            android:id="@+id/codeApprovalButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/code_text_indent"
            android:layout_marginTop="16dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/codeApprovalDone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/code_card_glyph_pad"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/codeRailNode"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_code_node">

            <ImageView
                android:id="@+id/codeApprovalDoneIcon"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/xai_mute" />
        </FrameLayout>

        <TextView
            android:id="@+id/codeApprovalDoneText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/xai_mute"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
