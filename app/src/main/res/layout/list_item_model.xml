<?xml version="1.0" encoding="utf-8"?>
<!-- Model row: maker mark, name, one quiet line. The row in use sits on a soft fill with a check. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/modelRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_model_row"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/modelRowContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_model_mark">

            <ImageView
                android:id="@+id/iconModelType"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/xai_ink"
                tools:src="@drawable/ic_brand_claude" />

            <TextView
                android:id="@+id/textModelMonogram"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                android:textFontWeight="700"
                android:visibility="gone"
                tools:text="B" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textModelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                android:textFontWeight="600"
                tools:text="Claude Sonnet 4" />

            <TextView
                android:id="@+id/textModelSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/xai_mute"
                android:textSize="13sp"
                tools:text="Anthropic · Vision" />
        </LinearLayout>

        <!-- Trailing mark: a check on the model in use, a plus in the catalogs. -->
        <ImageView
            android:id="@+id/iconSelected"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/model_picker_active"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@color/xai_ink"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>
