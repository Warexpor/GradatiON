<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/rounded_dialog_bg">

    <TextView
        android:id="@+id/dialog_titlemaxtokens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_maxtokens_set_max_tokens"
        android:textColor="@color/xai_ink"
        android:textAppearance="@style/TextAppearance.Gradation.Headline"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/save_maxtokens_enter_max_tokens"
        app:hintTextColor="@color/xai_mute"
        android:id="@+id/edit_text_lay_maxtokens">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_maxtokens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:inputType="number"
            android:digits="0123456789"

            android:textColor="@color/xai_ink"
            android:text="12000"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_maxtokens_help"
        android:textColor="@color/xai_ink"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancelmaxtokens"
            style="@style/Widget.Gradation.Button.Tonal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_savemaxtokens"
            style="@style/Widget.Grokion.Button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/action_save" />
    </LinearLayout>
</LinearLayout>
