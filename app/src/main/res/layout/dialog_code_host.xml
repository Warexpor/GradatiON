<?xml version="1.0" encoding="utf-8"?>
<!-- Add / edit a Code machine: name, bridge address, pairing token, fingerprint, default agent -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_dialog_bg"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/codeHostDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Gradation.Headline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/codeHostScanQr"
            style="@style/Widget.Gradation.Code.Button.Lead"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/code_pair_scan_qr"
            android:visibility="gone" />

        <TextView
            android:id="@+id/codeHostManualLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/code_pair_or_manual"
            android:textAppearance="@style/TextAppearance.Gradation.SectionHeader"
            android:textColor="@color/xai_mute"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/codeHostNameLayout"
            style="@style/Xai.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/code_host_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/codeHostName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:textColor="@color/xai_ink"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/codeHostUrlLayout"
            style="@style/Xai.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/code_host_url_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/codeHostUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="@color/xai_ink"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/codeHostTokenLayout"
            style="@style/Xai.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/code_host_token_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/codeHostToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/xai_ink"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/codeHostFingerprintLayout"
            style="@style/Xai.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/code_host_fingerprint_hint"
            app:helperText="@string/code_host_fingerprint_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/codeHostFingerprint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/atkinsonhyperlegiblemono_regular"
                android:inputType="textVisiblePassword"
                android:singleLine="true"
                android:textColor="@color/xai_ink"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="4dp"
            android:text="@string/code_host_agent_label"
            android:textAppearance="@style/TextAppearance.Gradation.SectionHeader" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/codeHostAgents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/codeHostStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Gradation.Footnote"
            android:textColor="@color/xai_mute"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/codeHostCancel"
                style="@style/Widget.Gradation.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/edit_response_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/codeHostSave"
                style="@style/Widget.Gradation.Code.Button.Lead"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/code_host_save" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/codeHostRemove"
            style="@style/Widget.Grokion.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/code_host_remove"
            android:textColor="@color/xai_mute"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
