<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rpLorebookName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                android:textFontWeight="600"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/rpLorebookActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/rp_lore_active_badge"
                android:textColor="@color/xai_ink"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rpLorebookActivateButton"
            style="@style/Widget.Grokion.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:maxWidth="120dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/rp_menu_set_active" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rpLorebookDeleteButton"
            style="@style/Widget.Grokion.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:maxWidth="100dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/rp_menu_delete" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:background="@color/xai_hairline" />
</LinearLayout>
