<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/xai_canvas"
    tools:context=".PresetEditFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:paddingEnd="4dp"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Edit Preset"
        app:titleTextColor="@color/xai_ink"
        android:background="@color/xai_canvas"
        app:navigationIcon="@drawable/is_backarrow"
        app:navigationIconTint="@color/xai_ink"
        app:menu="@menu/add_edit_preset_menu" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.textfield.TextInputLayout
                app:errorIconDrawable="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                style="@style/Xai.TextInputLayout"
                android:hint="@string/preset_edit_title">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editPresetTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                app:errorIconDrawable="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                style="@style/Xai.TextInputLayout"
                app:endIconMode="dropdown_menu"
                app:endIconDrawable="@drawable/ic_expand_more"
                app:endIconTint="@color/xai_mute"
                android:hint="@string/preset_edit_model">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/autoCompleteModel"
                    android:popupBackground="@drawable/bg_attach_popup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:textColor="@color/xai_ink"
                    android:textColorHint="@color/xai_mute"
                    android:textSize="16sp"
                    android:focusable="true"
                    android:clickable="true"
                    android:inputType="none" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                app:errorIconDrawable="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                style="@style/Xai.TextInputLayout"
                app:endIconMode="dropdown_menu"
                app:endIconDrawable="@drawable/ic_expand_more"
                app:endIconTint="@color/xai_mute"
                android:hint="@string/preset_edit_system_message">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/autoCompleteSystemMessage"
                    android:popupBackground="@drawable/bg_attach_popup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:textColor="@color/xai_ink"
                    android:textColorHint="@color/xai_mute"
                    android:textSize="16sp"
                    android:focusable="true"
                    android:clickable="true"
                    android:inputType="none" />

            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchStreaming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/preset_edit_streaming"
                android:textColor="@color/xai_ink"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchReasoning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/preset_edit_reasoning"
                android:textColor="@color/xai_ink"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchConversation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/preset_edit_conversation_mode"
                android:textColor="@color/xai_ink"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchWebSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/preset_edit_web_search"
                android:textColor="@color/xai_ink"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                android:text="@string/preset_edit_tools" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCancel"
                    style="@style/Widget.Gradation.Button.Tonal"
                    android:layout_width="0dp"
            android:layout_weight="1"
                    android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
                    android:text="@string/action_cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSave"
                    style="@style/Widget.Grokion.Button"
                    android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
                    android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
                    android:text="@string/action_save" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
