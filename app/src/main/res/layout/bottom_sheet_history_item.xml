<?xml version="1.0" encoding="utf-8"?>
<!-- Grok history row overflow: Delete / Rename / Pin -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingTop="12dp"
    android:paddingBottom="28dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="@color/xai_mute"
        android:alpha="0.4" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_edit"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/grok_history_rename"
        android:textColor="@color/xai_ink"
        android:textSize="16sp"
        app:icon="@drawable/ic_edit"
        app:iconTint="@color/xai_ink"
        app:iconGravity="start"
        app:iconPadding="16dp"
        app:iconSize="22dp"
        app:rippleColor="@color/press_ripple_none" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_pin"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/grok_history_pin"
        android:textColor="@color/xai_ink"
        android:textSize="16sp"
        app:icon="@drawable/ic_pin"
        app:iconTint="@color/xai_ink"
        app:iconGravity="start"
        app:iconPadding="16dp"
        app:iconSize="22dp"
        app:rippleColor="@color/press_ripple_none" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_delete"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/grok_history_delete"
        android:textColor="@color/xai_error"
        android:textSize="16sp"
        app:icon="@drawable/ic_trash"
        app:iconTint="@color/xai_error"
        app:iconGravity="start"
        app:iconPadding="16dp"
        app:iconSize="22dp"
        app:rippleColor="@color/press_ripple_none" />

</LinearLayout>
