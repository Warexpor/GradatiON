<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/rpCharacterAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_model_icon_circle"
            android:clipToOutline="true"
            android:src="@drawable/ic_gradation_mark"
            android:scaleType="centerCrop"
            android:contentDescription="@string/rp_character_avatar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rpCharacterName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                android:textFontWeight="600"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/rpCharacterActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/rp_character_active_badge"
                android:textColor="@color/xai_ink"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/rpCharacterSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/xai_mute"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rpCharacterActivateButton"
            style="@style/Widget.Grokion.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/rp_menu_start_chat" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rpCharacterDeleteButton"
            style="@style/Widget.Grokion.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/rp_menu_delete" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="76dp"
        android:background="@color/xai_hairline" />
</LinearLayout>
