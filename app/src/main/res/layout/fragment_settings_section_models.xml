<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/modelsSection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_card"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lanButton"
                style="@style/Widget.Grokion.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/settings_lan"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_local_network"
                app:iconGravity="start"
                app:iconPadding="16dp"
                app:iconSize="22dp"
                app:iconTint="@color/xai_ink"
                app:rippleColor="@color/press_ripple_none" />

            <!-- Current value; not clickable, so taps fall through to the row's button. -->
            <TextView
                android:id="@+id/lanValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:ellipsize="middle"
                android:importantForAccessibility="no"
                android:maxWidth="130dp"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Gradation.RowValue" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="54dp"
            android:background="@color/xai_hairline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_code_shield"
                app:tint="@color/xai_ink" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_trust_lan_tls"
                android:textColor="@color/xai_ink"
                android:textSize="16sp" 
                android:maxLines="2"
                android:ellipsize="end" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/trustSelfSignedLanSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="54dp"
            android:background="@color/xai_hairline" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/apiKeyButton"
                style="@style/Widget.Grokion.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/settings_openrouter_key"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_key"
                app:iconGravity="start"
                app:iconPadding="16dp"
                app:iconSize="22dp"
                app:iconTint="@color/xai_ink"
                app:rippleColor="@color/press_ripple_none" />

            <TextView
                android:id="@+id/apiKeyValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:ellipsize="middle"
                android:importantForAccessibility="no"
                android:maxWidth="130dp"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Gradation.RowValue" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="54dp"
            android:background="@color/xai_hairline" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/braveApiKeyButton"
                style="@style/Widget.Grokion.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/settings_brave_key"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_key"
                app:iconGravity="start"
                app:iconPadding="16dp"
                app:iconSize="22dp"
                app:iconTint="@color/xai_ink"
                app:rippleColor="@color/press_ripple_none" />

            <TextView
                android:id="@+id/braveApiKeyValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:ellipsize="middle"
                android:importantForAccessibility="no"
                android:maxWidth="130dp"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Gradation.RowValue" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="54dp"
            android:background="@color/xai_hairline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/creditsButton"
            style="@style/Widget.Grokion.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:minHeight="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/settings_remaining_credits"
            android:textColor="@color/xai_ink"
            android:textSize="16sp"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_credits"
            app:iconGravity="start"
            app:iconPadding="16dp"
            app:iconSize="22dp"
            app:iconTint="@color/xai_ink"
            app:rippleColor="@color/press_ripple_none" />
    </LinearLayout>
</LinearLayout>
