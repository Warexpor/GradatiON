<?xml version="1.0" encoding="utf-8"?>
<!-- Code transcript: one tool call as a single line; tap for output -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Claude Code style: one quiet line. Kind glyph, verb, mono argument; a spinner while it
         runs, a cross only on failure. Output hangs under it on tap. -->
    <LinearLayout
        android:id="@+id/codeToolRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:background="@drawable/bg_press_svg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/codeToolIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            app:tint="@color/xai_mute" />

        <TextView
            android:id="@+id/codeToolTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/xai_ink"
            android:textSize="14sp"
            android:textFontWeight="600" />

        <TextView
            android:id="@+id/codeToolDetail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Gradation.Code.Mono"
            android:textColor="@color/xai_mute" />

        <FrameLayout
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/codeToolSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                app:indicatorColor="@color/xai_mute"
                app:indicatorSize="12dp"
                app:trackThickness="1.5dp"
                app:trackColor="@android:color/transparent" />

            <ImageView
                android:id="@+id/codeToolStatus"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/xai_mute" />
        </FrameLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/codeToolOutputScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_code_block"
        android:scrollbars="none"
        android:visibility="gone">

        <TextView
            android:id="@+id/codeToolOutput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:lineSpacingMultiplier="1.25"
            android:textAppearance="@style/TextAppearance.Gradation.Code.Mono"
            android:textColor="@color/xai_body"
            android:textIsSelectable="true" />
    </HorizontalScrollView>

    <!-- Opens CodeToolOutputFragment; mirrors the diff card "more lines" affordance -->
    <TextView
        android:id="@+id/codeToolFull"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginStart="30dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_press_svg"
        android:clickable="true"
        android:focusable="true"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/xai_mute"
        android:textSize="13sp"
        android:textFontWeight="600"
        android:visibility="gone" />
</LinearLayout>
