<?xml version="1.0" encoding="utf-8"?>
<!-- Code transcript: one tool call. Glyph by kind, title, mono detail, status on the right; tap for output -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/codeToolRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@drawable/bg_press_svg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_code_icon_disc">

            <ImageView
                android:id="@+id/codeToolIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/xai_ink" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/codeToolTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/xai_ink"
                android:textSize="15sp"
                android:textFontWeight="500" />

            <TextView
                android:id="@+id/codeToolDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Gradation.Code.Mono" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/codeToolSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                app:indicatorColor="@color/xai_mute"
                app:indicatorSize="16dp"
                app:trackThickness="2dp"
                app:trackColor="@android:color/transparent" />

            <ImageView
                android:id="@+id/codeToolStatus"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/xai_mute" />
        </FrameLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/codeToolOutputScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_code_block"
        android:scrollbars="none"
        android:visibility="gone">

        <TextView
            android:id="@+id/codeToolOutput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:lineSpacingMultiplier="1.25"
            android:textAppearance="@style/TextAppearance.Gradation.Code.Mono"
            android:textColor="@color/xai_body"
            android:textIsSelectable="true" />
    </HorizontalScrollView>

    <!-- Opens CodeToolOutputFragment; mirrors the diff card "more lines" affordance -->
    <TextView
        android:id="@+id/codeToolFull"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_press_svg"
        android:clickable="true"
        android:focusable="true"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/xai_mute"
        android:textSize="13sp"
        android:textFontWeight="600"
        android:visibility="gone" />
</LinearLayout>
