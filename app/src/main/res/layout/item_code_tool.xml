<?xml version="1.0" encoding="utf-8"?>
<!-- Code transcript: one tool call as a single line on the rail; tap for output. The output pane
     ends on the cards' edge; the line's words end where prose does (14dp in). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/code_rail_row_pad"
    android:paddingEnd="@dimen/code_card_inset"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <!-- Claude Code style: one quiet line. Kind glyph in a bead on the rail (a ring orbits it while
         the tool runs), verb, mono argument, and a cross only on failure. Output hangs under it. -->
    <LinearLayout
        android:id="@+id/codeToolRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:background="@drawable/bg_press_svg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp">

        <FrameLayout
            android:id="@+id/codeRailNode"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_code_node">

            <ImageView
                android:id="@+id/codeToolIcon"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/xai_mute" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/codeToolSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                app:indicatorColor="@color/xai_ink"
                app:indicatorSize="20dp"
                app:trackThickness="1.5dp"
                app:trackColor="@android:color/transparent" />
        </FrameLayout>

        <!-- Capped so a long title still leaves the argument and a failure's cross on the line -->
        <TextView
            android:id="@+id/codeToolTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="220dp"
            android:textColor="@color/xai_ink"
            android:textSize="14sp"
            android:textFontWeight="600" />

        <TextView
            android:id="@+id/codeToolDetail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="middle"
            android:singleLine="true"
            style="@style/Widget.Gradation.Code.MonoLine"
            android:textColor="@color/xai_mute" />

        <ImageView
            android:id="@+id/codeToolStatus"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            app:tint="@color/xai_mute" />
    </LinearLayout>

    <!-- The terminal pane: a $ prompt line for commands, then the output. Long lines stop inside
         the side pads and fade there, instead of running into the rim and being cut mid-letter. -->
    <HorizontalScrollView
        android:id="@+id/codeToolOutputScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/code_text_indent"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_code_pane"
        android:clipToPadding="true"
        android:fadingEdgeLength="20dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/codeToolPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:singleLine="true"
                style="@style/Widget.Gradation.Code.MonoLine"
                android:textColor="@color/xai_ink"
                android:visibility="gone" />

            <TextView
                android:id="@+id/codeToolOutput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.25"
                style="@style/Widget.Gradation.Code.MonoLine"
                android:textColor="@color/xai_body"
                android:textIsSelectable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Opens CodeToolOutputFragment; mirrors the diff card "more lines" affordance. The words sit
         near the top of the 44dp target, so they read as the pane's caption, not a row of their own. -->
    <TextView
        android:id="@+id/codeToolFull"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/code_text_indent"
        android:background="@drawable/bg_press_svg"
        android:clickable="true"
        android:focusable="true"
        android:ellipsize="end"
        android:gravity="top|start"
        android:maxLines="1"
        android:paddingTop="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/xai_mute"
        android:textSize="13sp"
        android:textFontWeight="600"
        android:visibility="gone" />
</LinearLayout>
