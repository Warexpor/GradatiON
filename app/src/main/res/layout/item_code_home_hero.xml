<?xml version="1.0" encoding="utf-8"?>
<!-- Code home, no sessions yet: the chosen agent's mark in its orbits, standing by -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="36dp"
    android:paddingTop="72dp"
    android:paddingEnd="36dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_code_rings">

        <ImageView
            android:id="@+id/codeHeroMark"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_code_terminal"
            app:tint="@color/xai_ink" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:text="@string/code_home_greeting"
        android:textAppearance="@style/TextAppearance.Gradation.Title" />

    <TextView
        android:id="@+id/codeHeroSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:maxLines="3"
        android:textAppearance="@style/TextAppearance.Gradation.Footnote"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/codeHeroAgent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_code_chip_working"
        android:drawablePadding="7dp"
        android:ellipsize="middle"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:minHeight="28dp"
        android:paddingStart="11dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        style="@style/Widget.Gradation.Code.MonoLine"
        app:drawableStartCompat="@drawable/ic_code_led_on" />
</LinearLayout>
