<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/xai_grouped"
    android:fitsSystemWindows="true"
    tools:context=".AdvancedReasoningFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/settings_advanced_reasoning"
        app:titleTextColor="@color/xai_ink"
        android:background="@color/xai_grouped"
        app:navigationIcon="@drawable/is_backarrow"
        app:navigationIconTint="@color/xai_ink" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/advanced_reasoning_note"
                android:textColor="@color/xai_mute"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/advanced_reasoning_effort_level"
                android:textColor="@color/xai_ink"
                android:textSize="18sp"
                android:layout_marginBottom="16dp" />

            <!-- HSV so Minimal/Low/Medium/High never hard-clip on narrow / large-font -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <io.github.stardomains3.oxproxion.GlassSegmentedGroup
                    android:id="@+id/effortGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:minWidth="280dp"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonMinimal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        app:backgroundTint="@color/toggle_background_selector"
                        android:text="@string/advanced_reasoning_minimal"
                        app:strokeColor="@color/xai_hairline"
                        style="?attr/materialButtonOutlinedStyle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonLow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        app:backgroundTint="@color/toggle_background_selector"
                        android:text="@string/advanced_reasoning_low"
                        app:strokeColor="@color/xai_hairline"
                        style="?attr/materialButtonOutlinedStyle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        app:backgroundTint="@color/toggle_background_selector"
                        android:text="@string/advanced_reasoning_medium"
                        app:strokeColor="@color/xai_hairline"
                        style="?attr/materialButtonOutlinedStyle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonHigh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        app:backgroundTint="@color/toggle_background_selector"
                        android:text="@string/advanced_reasoning_high"
                        app:strokeColor="@color/xai_hairline"
                        style="?attr/materialButtonOutlinedStyle" />

                </io.github.stardomains3.oxproxion.GlassSegmentedGroup>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/advanced_reasoning_include_in_response"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/includeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/advanced_reasoning_max_reasoning_tokens"
                android:textColor="@color/xai_ink"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                style="@style/Xai.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/maxTokensEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/advanced_reasoning_optional"
                    android:inputType="number"
                    android:textColor="@color/xai_ink" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
