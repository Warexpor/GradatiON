<?xml version="1.0" encoding="utf-8"?>
<!-- History: large-title wordmark, grouped list, bottom search | settings | new chat -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xai_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context="SavedChatsFragment">

    <LinearLayout
        android:id="@+id/historyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/historyTitle"
                style="@style/GrokionBrandWordmark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/grokion_wordmark"
                android:textAllCaps="false"
                android:textColor="@color/xai_ink"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/historyModeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:textColor="@color/xai_mute"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/historyCloseButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_tonal"
            android:contentDescription="@string/grok_history_close"
            android:padding="10dp"
            android:src="@drawable/ic_drawer_collapse"
            android:visibility="visible"
            app:tint="@color/xai_ink" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/historyEmptyContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:layout_marginBottom="96dp"
            android:alpha="0.9"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_gradation_mark"
            app:tint="@color/xai_ink" />

        <TextView
            android:id="@+id/historyEmptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:lineSpacingMultiplier="1.35"
            android:padding="32dp"
            android:textColor="@color/xai_mute"
            android:textSize="15sp"
            tools:text="@string/grok_history_empty_text" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/savedChatsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/xai_canvas"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="12dp"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <LinearLayout
        android:id="@+id/historyBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/xai_canvas"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/historySearchView"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_history_search_pill"
            android:queryHint="@string/grok_history_search"
            app:iconifiedByDefault="false"
            app:queryBackground="@android:color/transparent"
            app:queryHint="@string/grok_history_search"
            app:searchIcon="@drawable/ic_search_stroke" />

        <ImageButton
            android:id="@+id/historySettingsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_tonal"
            android:contentDescription="@string/grok_settings"
            android:padding="10dp"
            android:src="@drawable/ic_settings_stroke"
            app:tint="@color/xai_ink" />

        <ImageButton
            android:id="@+id/historyNewChatButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_tonal"
            android:contentDescription="@string/grok_new_conversation"
            android:padding="9dp"
            android:src="@drawable/ic_new_chat"
            app:tint="@color/xai_ink" />
    </LinearLayout>

</LinearLayout>
