<?xml version="1.0" encoding="utf-8"?>
<!-- History: wordmark title, grouped list, bottom search | settings | new chat -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xai_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context="SavedChatsFragment">

    <LinearLayout
        android:id="@+id/historyHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp">

        <!-- Squared techno face here only. Both font attributes: the theme sets app:fontFamily, which wins over the android one alone. -->
        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/iceland_regular"
            app:fontFamily="@font/iceland_regular"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:text="@string/grokion_wordmark"
            android:textAllCaps="false"
            android:textColor="@color/xai_ink"
            android:textSize="38sp" />

        <ImageButton
            android:id="@+id/historyCloseButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_tonal"
            android:stateListAnimator="@animator/glass_press"
            android:contentDescription="@string/grok_history_close"
            android:padding="10dp"
            android:src="@drawable/ic_drawer_collapse"
            android:visibility="visible"
            app:tint="@color/xai_ink" />
    </LinearLayout>


    <!-- Grouped destinations (Grok drawer: Automations · Library · Projects) -->
    <LinearLayout
        android:id="@+id/historyNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_settings_card"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/historyNavCode"
            style="@style/Widget.Gradation.DrawerRow"
            android:text="@string/drawer_nav_code"
            app:icon="@drawable/ic_code_terminal" />
        <View
            android:id="@+id/historyNavCodeDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="54dp"
            android:background="@color/xai_hairline" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/historyNavRoleplay"
            style="@style/Widget.Gradation.DrawerRow"
            android:text="@string/drawer_nav_roleplay"
            app:icon="@drawable/ic_nav_characters" />
        <View
            android:id="@+id/historyNavRoleplayDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="54dp"
            android:background="@color/xai_hairline" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/historyNavModels"
            style="@style/Widget.Gradation.DrawerRow"
            android:text="@string/drawer_nav_models"
            app:icon="@drawable/ic_nav_models" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="54dp"
            android:background="@color/xai_hairline" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/historyNavPrompts"
            style="@style/Widget.Gradation.DrawerRow"
            android:text="@string/drawer_nav_prompts"
            app:icon="@drawable/ic_nav_prompts" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="54dp"
            android:background="@color/xai_hairline" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/historyNavPresets"
            style="@style/Widget.Gradation.DrawerRow"
            android:text="@string/drawer_nav_presets"
            app:icon="@drawable/ic_presets" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/historyEmptyContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <!-- One quiet line under the shortcuts, not a centered illustration -->
        <TextView
            android:id="@+id/historyEmptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:textColor="@color/xai_mute"
            android:textSize="15sp"
            tools:text="@string/grok_history_empty_title" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/savedChatsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/xai_canvas"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="12dp"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <LinearLayout
        android:id="@+id/historyBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/xai_canvas"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/historySearchView"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_history_search_pill"
            android:queryHint="@string/grok_history_search"
            app:iconifiedByDefault="false"
            app:queryBackground="@android:color/transparent"
            app:queryHint="@string/grok_history_search"
            app:searchIcon="@drawable/ic_search_stroke" />

        <ImageButton
            android:id="@+id/historySettingsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_tonal"
            android:stateListAnimator="@animator/glass_press"
            android:contentDescription="@string/grok_settings"
            android:padding="10dp"
            android:src="@drawable/ic_settings_stroke"
            app:tint="@color/xai_ink" />

        <ImageButton
            android:id="@+id/historyNewChatButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_tonal"
            android:stateListAnimator="@animator/glass_press"
            android:contentDescription="@string/grok_new_conversation"
            android:padding="10dp"
            android:src="@drawable/ic_new_chat"
            app:tint="@color/xai_ink" />
    </LinearLayout>

</LinearLayout>
