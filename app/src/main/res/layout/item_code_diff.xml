<?xml version="1.0" encoding="utf-8"?>
<!-- Code transcript: a file change as an editor pane. A tab-like header (file name, folder, counts),
     the first lines of the diff on the recessed code fill, tap for the full viewer. The rail stops
     at the glass card; the header glyph lands on the rail column. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="4dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/codeDiffCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_code_card"
        android:clickable="true"
        android:clipToOutline="true"
        android:focusable="true"
        android:foreground="@drawable/bg_press_svg"
        android:orientation="vertical"
        android:padding="1dp">

        <!-- The 1dp card inset keeps the code fill inside the rim, so the glyph frame is 18dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="13dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_code_file"
                app:tint="@color/xai_mute" />

            <TextView
                android:id="@+id/codeDiffPath"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:ellipsize="middle"
                android:maxWidth="200dp"
                android:singleLine="true"
                android:textColor="@color/xai_ink"
                android:textSize="14sp"
                android:textFontWeight="600" />

            <TextView
                android:id="@+id/codeDiffDir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:ellipsize="start"
                android:singleLine="true"
                style="@style/Widget.Gradation.Code.MonoLine"
                android:textColor="@color/xai_mute"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/codeDiffCounts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxWidth="96dp"
                android:maxLines="1"
                style="@style/Widget.Gradation.Code.MonoLine"
                android:textColor="@color/xai_ink"
                android:textSize="13sp" />
        </LinearLayout>

        <io.github.stardomains3.oxproxion.code.DiffView
            android:id="@+id/codeDiffLines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/code_block_bg" />

        <TextView
            android:id="@+id/codeDiffMore"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:textColor="@color/xai_mute"
            android:textSize="13sp"
            android:textFontWeight="600" />
    </LinearLayout>
</FrameLayout>
