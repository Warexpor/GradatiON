<?xml version="1.0" encoding="utf-8"?>
<!-- OpenRouter catalog: back | title | refresh, search, one line of chips, rows with a plus to add -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xai_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".OpenRouterModelsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/catalogBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_tonal"
            android:contentDescription="@string/cd_back"
            android:padding="10dp"
            android:src="@drawable/is_backarrow"
            android:stateListAnimator="@animator/glass_press"
            app:tint="@color/xai_ink" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/model_catalog_title"
            android:textColor="@color/xai_ink"
            android:textSize="24sp"
            android:textFontWeight="700" />

        <ImageButton
            android:id="@+id/catalogRefresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_tonal"
            android:contentDescription="@string/model_catalog_refresh"
            android:padding="11dp"
            android:src="@drawable/ic_refresh"
            android:stateListAnimator="@animator/glass_press"
            app:tint="@color/xai_ink" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_history_search_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search_stroke"
            app:tint="@color/xai_mute" />

        <EditText
            android:id="@+id/catalogSearchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/grok_model_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/xai_ink"
            android:textColorHint="@color/xai_mute"
            android:textSize="16sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/catalogFilterChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:fadingEdgeLength="28dp"
        android:requiresFadingEdge="vertical"
        android:id="@+id/recyclerViewOpenRouterModels"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/list_item_model" />

</LinearLayout>
