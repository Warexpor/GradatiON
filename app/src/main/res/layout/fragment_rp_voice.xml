<?xml version="1.0" encoding="utf-8"?>
<!-- RP character voice page: which system voice reads this character aloud, and how high and fast -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xai_grouped"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/xai_grouped"
        app:navigationContentDescription="@string/cd_navigate_up"
        app:navigationIcon="@drawable/is_backarrow"
        app:navigationIconTint="@color/xai_ink"
        app:titleTextColor="@color/xai_ink" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:text="@string/rp_voice_hint"
                android:textColor="@color/xai_mute"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/rpVoiceList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rp_voice_pitch"
                android:textColor="@color/xai_ink"
                android:textSize="15sp" />

            <io.github.stardomains3.oxproxion.GlassSegmentedGroup
                android:id="@+id/rpVoicePitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rpPitchLow"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rp_voice_low"
                    app:backgroundTint="@color/toggle_background_selector"
                    app:strokeColor="@color/xai_hairline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rpPitchMid"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rp_voice_normal"
                    app:backgroundTint="@color/toggle_background_selector"
                    app:strokeColor="@color/xai_hairline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rpPitchHigh"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rp_voice_high"
                    app:backgroundTint="@color/toggle_background_selector"
                    app:strokeColor="@color/xai_hairline" />
            </io.github.stardomains3.oxproxion.GlassSegmentedGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/rp_voice_speed"
                android:textColor="@color/xai_ink"
                android:textSize="15sp" />

            <io.github.stardomains3.oxproxion.GlassSegmentedGroup
                android:id="@+id/rpVoiceRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rpRateSlow"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rp_voice_slow"
                    app:backgroundTint="@color/toggle_background_selector"
                    app:strokeColor="@color/xai_hairline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rpRateMid"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rp_voice_normal"
                    app:backgroundTint="@color/toggle_background_selector"
                    app:strokeColor="@color/xai_hairline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rpRateFast"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rp_voice_fast"
                    app:backgroundTint="@color/toggle_background_selector"
                    app:strokeColor="@color/xai_hairline" />
            </io.github.stardomains3.oxproxion.GlassSegmentedGroup>
        </LinearLayout>


            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
