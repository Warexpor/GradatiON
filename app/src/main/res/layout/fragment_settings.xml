<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/xai_grouped"
    android:fitsSystemWindows="true"
    tools:context=".SettingsFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/xai_grouped"
        app:navigationIcon="@drawable/ic_close_x"
        app:navigationIconTint="@color/xai_ink"
        app:title="@string/settings_title"
        app:titleTextColor="@color/xai_ink" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp"
                android:text="@string/settings_group_app"
                android:textAppearance="@style/TextAppearance.Gradation.SectionHeader" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_settings_card"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsRowAppearance"
                    style="@style/Widget.Grokion.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:minHeight="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/settings_section_appearance"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_palette"
                    app:iconGravity="start"
                    app:iconPadding="16dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/xai_ink"
                    app:rippleColor="@color/press_ripple_none" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:layout_marginEnd="0dp"
                    android:background="@color/xai_hairline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsRowHaptics"
                    style="@style/Widget.Grokion.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:minHeight="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/settings_section_haptics"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_mobilesound"
                    app:iconGravity="start"
                    app:iconPadding="16dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/xai_ink"
                    app:rippleColor="@color/press_ripple_none" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:layout_marginEnd="0dp"
                    android:background="@color/xai_hairline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsRowAdvanced"
                    style="@style/Widget.Grokion.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:minHeight="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/settings_section_advanced"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_tune"
                    app:iconGravity="start"
                    app:iconPadding="16dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/xai_ink"
                    app:rippleColor="@color/press_ripple_none" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:layout_marginEnd="0dp"
                    android:background="@color/xai_hairline" />

                <!-- Code mode: third tab for driving coding agents on your machines (code/CodeSettingsFragment) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsRowCode"
                    style="@style/Widget.Grokion.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:minHeight="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/settings_section_code"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_code_terminal"
                    app:iconGravity="start"
                    app:iconPadding="16dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/xai_ink"
                    app:rippleColor="@color/press_ripple_none" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp"
                android:text="@string/settings_group_grok"
                android:textAppearance="@style/TextAppearance.Gradation.SectionHeader" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_settings_card"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsRowModels"
                    style="@style/Widget.Grokion.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:minHeight="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/settings_section_models"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_cloud"
                    app:iconGravity="start"
                    app:iconPadding="16dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/xai_ink"
                    app:rippleColor="@color/press_ripple_none" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:layout_marginEnd="0dp"
                    android:background="@color/xai_hairline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsRowData"
                    style="@style/Widget.Grokion.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:minHeight="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/settings_section_data"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_fingerprint"
                    app:iconGravity="start"
                    app:iconPadding="16dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/xai_ink"
                    app:rippleColor="@color/press_ripple_none" />
            </LinearLayout>

            <!-- STT disabled: Voice settings section (id omitted here — live stub below keeps settingsRowVoice)
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="16dp"
                android:text="@string/settings_group_voice"
                android:textAppearance="@style/TextAppearance.Gradation.SectionHeader" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_settings_card"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Grokion.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:minHeight="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/settings_section_voice"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
                    app:icon="@drawable/ic_mic"
                    app:iconGravity="start"
                    app:iconPadding="16dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/xai_ink"
                    app:rippleColor="@color/press_ripple_none" />
            </LinearLayout>
            -->

            <!-- Keep ID for SettingsFragment findViewById; STT feature commented out -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsRowVoice"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
