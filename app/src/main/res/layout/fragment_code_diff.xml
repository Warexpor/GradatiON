<?xml version="1.0" encoding="utf-8"?>
<!-- Full diff: path + counts in the nav bar, every line, scroll both ways -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xai_canvas"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/xai_canvas"
        app:navigationContentDescription="@string/cd_code_back"
        app:navigationIcon="@drawable/is_backarrow"
        app:navigationIconTint="@color/xai_ink"
        app:titleTextColor="@color/xai_ink"
        app:subtitleTextColor="@color/xai_mute" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <io.github.stardomains3.oxproxion.code.DiffView
                android:id="@+id/codeDiffFull"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </HorizontalScrollView>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
