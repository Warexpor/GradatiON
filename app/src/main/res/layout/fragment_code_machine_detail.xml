<?xml version="1.0" encoding="utf-8"?>
<!-- Code machine detail: status, bridge version, harnesses, revoke this phone -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xai_grouped"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/xai_grouped"
        app:navigationContentDescription="@string/cd_code_back"
        app:navigationIcon="@drawable/is_backarrow"
        app:navigationIconTint="@color/xai_ink"
        app:title="@string/code_machine_detail_title"
        app:titleTextColor="@color/xai_ink"
        app:subtitleTextColor="@color/xai_mute" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- Identity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/codeMachineName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/xai_ink"
                    android:textFontWeight="600"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/codeMachineUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="middle"
                    android:fontFamily="@font/atkinsonhyperlegiblemono_regular"
                    android:maxLines="2"
                    android:textColor="@color/xai_mute"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/codeMachineTransport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="@style/TextAppearance.Gradation.Footnote"
                    android:textColor="@color/xai_body"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/codeMachineFingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/atkinsonhyperlegiblemono_regular"
                    android:textAppearance="@style/TextAppearance.Gradation.Footnote"
                    android:textColor="@color/xai_mute"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Status -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/code_machine_section_status"
                android:textAppearance="@style/TextAppearance.Gradation.SectionHeader" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/codeMachineStatusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_code_dot" />

                    <TextView
                        android:id="@+id/codeMachineStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/xai_ink"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/codeMachineLastError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/xai_error"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/codeMachineVersionDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/xai_hairline" />

                <TextView
                    android:id="@+id/codeMachineVersionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/code_machine_bridge_version"
                    android:textAppearance="@style/TextAppearance.Gradation.Footnote"
                    android:textColor="@color/xai_mute" />

                <TextView
                    android:id="@+id/codeMachineBridgeVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/xai_ink"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Harnesses -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/code_machine_section_harnesses"
                android:textAppearance="@style/TextAppearance.Gradation.SectionHeader" />

            <LinearLayout
                android:id="@+id/codeMachineHarnessesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/codeMachineHarnessesHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="6dp"
                android:text="@string/code_machine_harnesses_offline"
                android:textAppearance="@style/TextAppearance.Gradation.Footnote"
                android:visibility="gone" />

            <!-- Actions -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/codeMachineEdit"
                style="@style/Widget.Gradation.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/code_machine_edit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/codeMachineRevoke"
                style="@style/Widget.Grokion.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:text="@string/code_machine_revoke"
                android:textColor="@color/xai_error" />

            <TextView
                android:id="@+id/codeMachineRevokeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/code_machine_revoke_hint"
                android:textAppearance="@style/TextAppearance.Gradation.Footnote" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
