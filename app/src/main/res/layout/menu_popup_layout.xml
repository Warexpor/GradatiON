<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_rounded_bg">

    <TextView
        android:id="@+id/menu_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="12dp"
        android:gravity="center_vertical"
        android:minWidth="160dp"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:text="@string/rp_menu_edit"
        android:textColor="@color/xai_ink"
        android:textSize="16sp"
        app:drawableStartCompat="@drawable/ic_edit"
        app:drawableTint="@color/xai_ink" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/xai_hairline" />

    <TextView
        android:id="@+id/menu_delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="12dp"
        android:gravity="center_vertical"
        android:minWidth="160dp"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:text="@string/rp_menu_delete"
        android:textColor="@color/xai_error"
        android:textSize="16sp"
        app:drawableStartCompat="@drawable/ic_trash"
        app:drawableTint="@color/xai_error" />

</LinearLayout>
