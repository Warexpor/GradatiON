<?xml version="1.0" encoding="utf-8"?>
<!-- Code session: transcript scrolls under floating liquid-glass chrome (same shape as the chat screen) -->
<io.github.stardomains3.oxproxion.SwipeNavLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/codeSessionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xai_canvas"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/codeSessionFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <io.github.stardomains3.oxproxion.GlassBackdropLayout
            android:id="@+id/codeSessionBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Canvas + ambient background in their own backdrop: the transcript sheet blurs only
                 these, so scrolling the transcript never re-blurs the sheet under it -->
            <io.github.stardomains3.oxproxion.GlassBackdropLayout
                android:id="@+id/codeSessionAmbientBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/xai_canvas"
                    android:importantForAccessibility="no" />

                <io.github.stardomains3.oxproxion.AmbientBackgroundView
                    android:id="@+id/codeAmbient"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
            </io.github.stardomains3.oxproxion.GlassBackdropLayout>

            <!-- The transcript's glass sheet: one blur layer, no lens (too wide to bend), clipped so
                 rows dissolve at its top edge. Top and bottom margins follow the header and dock. -->
            <io.github.stardomains3.oxproxion.GlassFrameLayout
                android:id="@+id/codeSessionSheet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginTop="68dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="4dp"
                app:glassBlurRadius="28dp"
                app:glassCornerRadius="32dp"
                app:glassLens="false"
                app:glassTint="@color/glass_tint">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/codeTranscript"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:fadingEdgeLength="28dp"
                    android:overScrollMode="never"
                    android:paddingTop="6dp"
                    android:paddingBottom="120dp"
                    android:requiresFadingEdge="vertical"
                    android:scrollbars="none" />
            </io.github.stardomains3.oxproxion.GlassFrameLayout>
        </io.github.stardomains3.oxproxion.GlassBackdropLayout>

        <!-- Empty transcript: loading, waiting for the agent, or a load that failed (tap to retry).
             Centred in the clear part of the sheet; the margins are set on layout. -->
        <TextView
            android:id="@+id/codeSessionState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:accessibilityLiveRegion="polite"
            android:drawablePadding="18dp"
            android:gravity="center"
            android:minHeight="44dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:textColor="@color/xai_mute"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Top: back · title · options, above the sheet (the transcript never scrolls under it) -->
        <FrameLayout
            android:id="@+id/codeSessionTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp">

                <io.github.stardomains3.oxproxion.GlassIconButton
                    android:id="@+id/codeSessionBack"
                    style="@style/Widget.Grokion.IconButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/cd_code_back"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@android:color/transparent"
                    app:glassElevation="4dp"
                    app:glassInteractive="true"
                    app:glassTint="@color/glass_control_tint"
                    app:icon="@drawable/is_backarrow"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/xai_ink" />

                <!-- The agent on the other end: its mark (lit while it works or waits on you), title, and where -->
                <LinearLayout
                    android:id="@+id/codeSessionPod"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_code_pod"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp">

                        <ImageView
                            android:id="@+id/codeSessionMark"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_code_mark_tile"
                            android:importantForAccessibility="no"
                            android:padding="9dp"
                            app:tint="@color/xai_ink" />

                        <View
                            android:id="@+id/codeSessionHeaderLed"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="bottom|end"
                            android:importantForAccessibility="no"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/codeSessionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/xai_ink"
                            android:textSize="15sp"
                            android:textFontWeight="600" />

                        <TextView
                            android:id="@+id/codeSessionSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:textColor="@color/xai_mute"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <io.github.stardomains3.oxproxion.GlassIconButton
                    android:id="@+id/codeSessionMore"
                    style="@style/Widget.Grokion.IconButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/code_session_more"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@android:color/transparent"
                    app:glassElevation="4dp"
                    app:glassInteractive="true"
                    app:glassTint="@color/glass_control_tint"
                    app:icon="@drawable/ic_more_vert"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/xai_ink" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/codeSessionDock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">

            <!-- Offline banner: the same glass capsule as the approval pin, so the stack over the
                 composer shares its edges, and the light starts where the composer's words do.
                 Start-aligned, because centred lines left a long message adrift from its light. -->
            <io.github.stardomains3.oxproxion.GlassTextView
                android:id="@+id/codeSessionBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="6dp"
                android:drawablePadding="10dp"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:clickable="true"
                android:focusable="true"
                android:maxLines="5"
                android:minHeight="44dp"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:paddingBottom="10dp"
                android:textColor="@color/xai_ink"
                android:textSize="13sp"
                android:visibility="gone"
                app:glassCornerRadius="18dp"
                app:glassInteractive="true"
                app:glassTint="@color/glass_control_tint" />

            <!-- Pending approval pin: glass capsule above the composer when the card is off-screen. Its
                 words start where the composer's do (8dp pad + 10dp input pad). -->
            <io.github.stardomains3.oxproxion.GlassTextView
                android:id="@+id/codeSessionApprovalBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:minHeight="44dp"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:paddingBottom="10dp"
                android:textColor="@color/xai_ink"
                android:textSize="13.5sp"
                android:visibility="gone"
                app:glassCornerRadius="18dp"
                app:glassElevation="4dp"
                app:glassInteractive="true"
                app:glassTint="@color/glass_control_tint" />

            <include
                android:id="@+id/codeSessionComposer"
                layout="@layout/view_code_composer" />
        </LinearLayout>
    </FrameLayout>
</io.github.stardomains3.oxproxion.SwipeNavLayout>
