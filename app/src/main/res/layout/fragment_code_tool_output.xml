<?xml version="1.0" encoding="utf-8"?>
<!-- Full tool output: mono log, glass find field, Copy in the toolbar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xai_canvas"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/xai_canvas"
        app:navigationContentDescription="@string/cd_code_back"
        app:navigationIcon="@drawable/is_backarrow"
        app:navigationIconTint="@color/xai_ink"
        app:titleTextColor="@color/xai_ink"
        app:subtitleTextColor="@color/xai_mute" />

    <EditText
        android:id="@+id/codeToolOutputFind"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_history_search_pill"
        android:drawableStart="@drawable/ic_search_stroke"
        android:drawablePadding="10dp"
        android:drawableTint="@color/xai_mute"
        android:ellipsize="end"
        android:hint="@string/code_tool_output_find_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/xai_ink"
        android:textColorHint="@color/xai_mute"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/codeToolOutputTruncated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/code_tool_output_truncated_hint"
        android:textColor="@color/xai_mute"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/codeToolOutputScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/codeToolOutputBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:lineSpacingMultiplier="1.25"
                android:textAppearance="@style/TextAppearance.Gradation.Code.Mono"
                android:textColor="@color/xai_body"
                android:textIsSelectable="true" />
        </HorizontalScrollView>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
