<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xai_grouped"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/xai_grouped"
        app:navigationContentDescription="@string/cd_navigate_up"
        app:navigationIcon="@drawable/is_backarrow"
        app:navigationIconTint="@color/xai_ink"
        app:title="@string/rp_characters_title"
        app:titleTextColor="@color/xai_ink" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 10dp list padding + 6dp card padding = 16dp gutters -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rpCharacterRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <include
            android:id="@+id/rpCharacterEmpty"
            layout="@layout/include_rp_empty"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/rpCharacterHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/rp_ui_library_hint"
        android:visibility="gone"
        android:textAppearance="@style/TextAppearance.Gradation.Footnote"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addRpCharacterButton"
        style="@style/Widget.Grokion.Button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/rp_add_character"
        app:icon="@drawable/ic_attach_plus"
        app:iconGravity="textStart"
        app:iconTint="@color/xai_ink" />
</LinearLayout>
