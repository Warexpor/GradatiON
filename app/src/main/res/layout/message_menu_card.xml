<?xml version="1.0" encoding="utf-8"?>
<!-- The ⋮ menu on a message (MessageMenu): a compact card, blur and a soft edge, no lens rim. -->
<io.github.stardomains3.oxproxion.GlassLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="190dp"
    android:orientation="vertical"
    android:padding="6dp"
    app:glassCornerRadius="20dp"
    app:glassElevation="14dp"
    app:glassLens="false"
    app:glassTint="@color/glass_menu_tint" />
