<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/xai_canvas"
    android:fitsSystemWindows="true"
    tools:context="io.github.stardomains3.oxproxion.LicenseDetailFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        tools:title="Library License"
        app:titleTextColor="@color/xai_ink"
        android:background="@color/xai_canvas"
        app:navigationIcon="@drawable/is_backarrow"
        app:navigationIconTint="@color/xai_ink" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:background="@color/xai_canvas"
        android:fillViewport="true">

        <TextView
            android:id="@+id/licenseContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:typeface="monospace"
            android:textColor="@color/xai_ink"
            android:textIsSelectable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColorHighlight="@color/xai_text_highlight"
            tools:text="Full license text appears here... (Long-press to select/copy)" />

    </ScrollView>

</LinearLayout>