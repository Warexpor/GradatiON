<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/iconModelType"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        app:srcCompat="@drawable/ic_lan"
        app:tint="@color/xai_mute" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textModelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Model ID"
            android:textSize="16sp"
            android:textFontWeight="600"
            android:textColor="@color/xai_ink"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Llama-3-8B" />

        <TextView
            android:id="@+id/textModelDisplayName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Model Name"
            android:textSize="13sp"
            android:textColor="@color/xai_mute"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Llama 3 8B Instruct" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnEject"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/ic_eject"
        android:visibility="gone"
        app:tint="@color/xai_mute" />

    <ImageButton
        android:id="@+id/btnLoad"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/ic_loadmodel"
        android:visibility="gone"
        app:tint="@color/xai_mute" />

    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/iconAdded"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/cd_model_added"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        app:tint="@color/xai_ink" />

</LinearLayout>
