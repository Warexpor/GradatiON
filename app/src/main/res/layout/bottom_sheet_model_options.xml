<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press on a model: which model, then Edit / Open on OpenRouter / Remove -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:alpha="0.4"
        android:background="@color/xai_mute" />

    <include
        android:id="@+id/modelOptionsHeader"
        layout="@layout/list_item_model" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:background="@color/xai_hairline" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_edit"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/rp_menu_edit"
        android:textColor="@color/xai_ink"
        android:textSize="16sp"
        app:icon="@drawable/ic_edit"
        app:iconGravity="start"
        app:iconPadding="16dp"
        app:iconSize="22dp"
        app:iconTint="@color/xai_ink"
        app:rippleColor="@color/press_ripple_none" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_open_page"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/model_options_open_page"
        android:textColor="@color/xai_ink"
        android:textSize="16sp"
        app:icon="@drawable/ic_outbound"
        app:iconGravity="start"
        app:iconPadding="16dp"
        app:iconSize="22dp"
        app:iconTint="@color/xai_ink"
        app:rippleColor="@color/press_ripple_none" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_delete"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minHeight="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/model_options_remove"
        android:textColor="@color/delete_action"
        android:textSize="16sp"
        app:icon="@drawable/ic_trash"
        app:iconGravity="start"
        app:iconPadding="16dp"
        app:iconSize="22dp"
        app:iconTint="@color/delete_action"
        app:rippleColor="@color/press_ripple_none" />

    <TextView
        android:id="@+id/modelOptionsLocked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:text="@string/model_default_locked"
        android:textColor="@color/xai_mute"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
