<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/xai_grouped"
    android:fitsSystemWindows="true"
    tools:context=".InferenceParametersFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Inference Parameters"
        app:titleTextColor="@color/xai_ink"
        android:background="@color/xai_grouped"
        app:navigationIcon="@drawable/is_backarrow"
        app:navigationIconTint="@color/xai_ink" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/inference_parameters_temperature"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
                    android:textFontWeight="600"
                    android:maxLines="2"
                    android:ellipsize="end" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/tempSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tempInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/inference_parameters_e_g_1_0"
                style="@style/Xai.TextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tempEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/inference_parameters_top_p"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
                    android:textFontWeight="600"
                    android:maxLines="2"
                    android:ellipsize="end" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/topPSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/topPInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/inference_parameters_e_g_1_0"
                style="@style/Xai.TextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/topPEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/inference_parameters_top_k"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
                    android:textFontWeight="600"
                    android:maxLines="2"
                    android:ellipsize="end" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/topKSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/topKInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/inference_parameters_e_g_40"
                style="@style/Xai.TextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/topKEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/inference_not_every_server"
                android:textAppearance="@style/TextAppearance.Gradation.Footnote" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/inference_parameters_min_p"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
                    android:textFontWeight="600"
                    android:maxLines="2"
                    android:ellipsize="end" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/minPSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/minPInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/inference_parameters_e_g_0_0"
                style="@style/Xai.TextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/minPEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/inference_not_every_server"
                android:textAppearance="@style/TextAppearance.Gradation.Footnote" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/inference_parameters_repetition_penalty"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
                    android:textFontWeight="600"
                    android:maxLines="2"
                    android:ellipsize="end" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/repPenaltySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/repPenaltyInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/inference_parameters_e_g_1_0"
                style="@style/Xai.TextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/repPenaltyEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/inference_not_every_server"
                android:textAppearance="@style/TextAppearance.Gradation.Footnote" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/inference_parameters_presence_penalty"
                    android:textColor="@color/xai_ink"
                    android:textSize="16sp"
                    android:textFontWeight="600"
                    android:maxLines="2"
                    android:ellipsize="end" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/presPenaltySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/presPenaltyInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/inference_parameters_e_g_0_0"
                style="@style/Xai.TextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/presPenaltyEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
