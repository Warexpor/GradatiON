<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/xai_grouped"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/settings_manage_tools"
        app:titleTextColor="@color/xai_ink"
        android:background="@color/xai_grouped"
        app:navigationIcon="@drawable/is_backarrow"
        app:navigationIconTint="@color/xai_ink" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- One card of rows, like every other Settings list; rows are added in ToolsFragment -->
            <LinearLayout
                android:id="@+id/tools_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_card"
                android:divider="@drawable/divider_settings_row"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:showDividers="middle" />

            <!-- The Brave tools are left out of the list until there is a key to run them with -->
            <TextView
                android:id="@+id/tools_brave_footnote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="6dp"
                android:text="@string/tools_brave_needs_key"
                android:textAppearance="@style/TextAppearance.Gradation.Footnote"
                android:visibility="gone" />
        </LinearLayout>

    </ScrollView>

</LinearLayout>
