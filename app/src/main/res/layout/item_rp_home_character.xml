<?xml version="1.0" encoding="utf-8"?>
<!-- One character in the Roleplay home strip: a portrait and a name, tap to start a chat. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="78dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_press_svg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:layout_width="62dp"
        android:layout_height="62dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/rpHomeCharAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rp_bg_monogram"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/XaiShapePill" />

        <TextView
            android:id="@+id/rpHomeCharMonogram"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/app_sans"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/xai_mute"
            android:textFontWeight="600"
            android:textSize="24sp" />

        <ImageView
            android:id="@+id/rpHomeCharGlyph"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:tint="@color/xai_mute" />
    </FrameLayout>

    <TextView
        android:id="@+id/rpHomeCharName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/app_sans"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:singleLine="true"
        android:textColor="@color/xai_body"
        android:textFontWeight="600"
        android:textSize="13sp" />
</LinearLayout>
