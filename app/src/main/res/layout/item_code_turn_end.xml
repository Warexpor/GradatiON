<?xml version="1.0" encoding="utf-8"?>
<!-- End of an agent turn: the rail stops in a hollow ring, then a mono summary and a hairline -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <!-- 9dp ring centred in the 20dp rail column -->
    <View
        android:id="@+id/codeRailNode"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_marginStart="5.5dp"
        android:layout_marginEnd="15.5dp"
        android:background="@drawable/bg_code_turn_cap"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/codeTurnText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        style="@style/Widget.Gradation.Code.MonoLine"
        android:textColor="@color/xai_mute"
        android:textSize="12sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:background="@color/xai_hairline" />
</LinearLayout>
