<?xml version="1.0" encoding="utf-8"?>
<!-- Code transcript: agent prose, full width, no bubble (like chat replies) -->
<io.github.stardomains3.oxproxion.ChatTextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/codeAgentText"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:textColor="@color/xai_body"
    android:textSize="16sp"
    android:lineSpacingMultiplier="1.36"
    android:textIsSelectable="true" />
