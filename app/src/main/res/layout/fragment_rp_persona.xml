<?xml version="1.0" encoding="utf-8"?>
<!-- Persona: who you are (name and a description), your saved personas one tap away, pinned Save -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xai_grouped"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/xai_grouped"
        app:navigationContentDescription="@string/cd_navigate_up"
        app:navigationIcon="@drawable/is_backarrow"
        app:navigationIconTint="@color/xai_ink"
        app:title="@string/rp_persona_title"
        app:titleTextColor="@color/xai_ink" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:id="@+id/rpPersonaAvatarFrame"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:contentDescription="@string/rp_pick_avatar"
            android:focusable="true"
            android:stateListAnimator="@animator/press_scale">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/rpPersonaAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/rp_bg_monogram"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/XaiShapePill" />

            <TextView
                android:id="@+id/rpPersonaMonogram"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/app_sans"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/xai_mute"
                android:textFontWeight="600"
                android:textSize="42sp" />

            <ImageView
                android:id="@+id/rpPersonaSilhouette"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_avatar_placeholder" />

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/rp_bg_badge">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/rp_ic_camera"
                    app:tint="@color/xai_ink" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rpPersonaPickPhoto"
                style="@style/Widget.Grokion.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:maxWidth="160dp"
                android:minWidth="0dp"
                android:text="@string/rp_ui_add_photo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rpPersonaRemovePhoto"
                style="@style/Widget.Grokion.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:maxWidth="120dp"
                android:minWidth="0dp"
                android:text="@string/rp_ui_remove_photo"
                android:textColor="@color/xai_mute"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/rp_ui_persona_intro"
            android:textAppearance="@style/TextAppearance.Gradation.Footnote"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/rp_ui_section_you"
            android:textAppearance="@style/TextAppearance.Gradation.SectionHeader" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/rp_persona_name_hint"
            app:boxBackgroundColor="@color/xai_cell">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/rpPersonaNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/rp_persona_hint"
            app:boxBackgroundColor="@color/xai_cell">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/rpPersonaInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top"
                android:minLines="5" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:text="@string/rp_persona_footer"
            android:textAppearance="@style/TextAppearance.Gradation.Footnote"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/rpPersonaListHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/rp_persona_presets"
            android:textAppearance="@style/TextAppearance.Gradation.SectionHeader" />

        <LinearLayout
            android:id="@+id/rpPersonaList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rp_bg_card"
            android:clipToOutline="true"
            android:orientation="vertical" />
    </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveRpPersonaButton"
        style="@style/Widget.Grokion.Button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/rp_save_persona" />
</LinearLayout>
