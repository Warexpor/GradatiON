<?xml version="1.0" encoding="utf-8"?>
<!-- Attach context menu: Camera / Photos / Files, attached-file review, Tools -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_attach_popup"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:minWidth="220dp"
    android:elevation="8dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/attachCamera"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="start|center_vertical"
        android:text="@string/grok_attach_camera"
        android:textColor="@color/xai_ink"
        android:textSize="16sp"
        android:textAllCaps="false"
        app:icon="@drawable/ic_camera"
        app:iconTint="@color/xai_ink"
        app:iconGravity="start"
        app:iconPadding="14dp"
        app:iconSize="22dp"
        app:rippleColor="@color/press_ripple_none" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/attachGallery"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="start|center_vertical"
        android:text="@string/grok_attach_gallery"
        android:textColor="@color/xai_ink"
        android:textSize="16sp"
        android:textAllCaps="false"
        app:icon="@drawable/ic_gallery"
        app:iconTint="@color/xai_ink"
        app:iconGravity="start"
        app:iconPadding="14dp"
        app:iconSize="22dp"
        app:rippleColor="@color/press_ripple_none" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/attachFiles"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="start|center_vertical"
        android:text="@string/grok_attach_files"
        android:textColor="@color/xai_ink"
        android:textSize="16sp"
        android:textAllCaps="false"
        app:icon="@drawable/ic_attachdoc"
        app:iconTint="@color/xai_ink"
        app:iconGravity="start"
        app:iconPadding="14dp"
        app:iconSize="22dp"
        app:rippleColor="@color/press_ripple_none" />

    <!-- Shown only while files are staged for the next message -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/attachReviewFiles"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="start|center_vertical"
        android:textColor="@color/xai_mute"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:visibility="gone"
        app:icon="@drawable/ic_check"
        app:iconTint="@color/xai_mute"
        app:iconGravity="start"
        app:iconPadding="14dp"
        app:iconSize="22dp"
        app:rippleColor="@color/press_ripple_none" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@color/xai_hairline" />

    <!-- Grok "Connectors" slot → local Tools (real capability) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/attachTools"
        style="@style/Widget.Grokion.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="start|center_vertical"
        android:text="@string/settings_manage_tools"
        android:textColor="@color/xai_ink"
        android:textSize="16sp"
        android:textAllCaps="false"
        app:icon="@drawable/ic_tools"
        app:iconTint="@color/xai_ink"
        app:iconGravity="start"
        app:iconPadding="14dp"
        app:iconSize="22dp"
        app:rippleColor="@color/press_ripple_none" />

</LinearLayout>
