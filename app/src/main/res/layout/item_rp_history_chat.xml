<?xml version="1.0" encoding="utf-8"?>
<!-- One chat on the chats page: when, the last line, how long it runs -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rpHistoryWhen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/app_sans"
            android:singleLine="true"
            android:textColor="@color/xai_mute"
            android:textFontWeight="600"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/rpHistoryCurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/app_sans"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="@string/rp_history_current"
            android:textColor="@color/xai_ink"
            android:textFontWeight="600"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/rpHistoryPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/app_sans"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="3"
        android:textColor="@color/xai_ink"
        android:textSize="15.5sp" />

    <TextView
        android:id="@+id/rpHistoryLength"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/app_sans"
        android:textColor="@color/xai_mute"
        android:textSize="13sp" />
</LinearLayout>
