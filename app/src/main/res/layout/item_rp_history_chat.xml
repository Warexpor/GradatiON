<?xml version="1.0" encoding="utf-8"?>
<!-- One chat on the chats page: when and how long on one line, then the last line. Kept short so a screen shows several. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rpHistoryWhen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/app_sans"
            android:singleLine="true"
            android:textColor="@color/xai_mute"
            android:textFontWeight="600"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/rpHistoryCurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/app_sans"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="@string/rp_history_current"
            android:textColor="@color/xai_ink"
            android:textFontWeight="600"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 44dp target that pulls back into the card's padding, so the row keeps its height -->
        <ImageButton
            android:id="@+id/rpHistoryMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="-12dp"
            android:layout_marginEnd="-14dp"
            android:layout_marginBottom="-12dp"
            android:background="@null"
            android:contentDescription="@string/cd_more_actions"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/xai_mute" />
    </LinearLayout>

    <TextView
        android:id="@+id/rpHistoryPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/app_sans"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="2"
        android:textColor="@color/xai_ink"
        android:textSize="15.5sp" />
</LinearLayout>
