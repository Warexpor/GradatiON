<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/xai_canvas"
    tools:context="io.github.stardomains3.oxproxion.HelpFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/settings_help"
        app:titleTextColor="@color/xai_ink"
        android:background="@color/xai_canvas"
        app:navigationIcon="@drawable/is_backarrow"
        app:navigationIconTint="@color/xai_ink" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <TextView
            android:id="@+id/helpContentTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:linksClickable="true"
            android:textColorHighlight="@color/xai_link"
            android:textColorLink="@color/xai_link"
            android:textColor="@color/xai_ink"
            android:textIsSelectable="true"
            android:textSize="16sp"
            tools:text="Markdown content will be here." />
    </ScrollView>

</LinearLayout>
