<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/xai_grouped"
    android:fitsSystemWindows="true"
    tools:context=".SettingsDetailFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/xai_grouped"
        app:navigationIcon="@drawable/is_backarrow"
        app:navigationIconTint="@color/xai_ink"
        app:title="@string/settings_title"
        app:titleTextColor="@color/xai_ink" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">

        <!-- The open section is inflated in here from fragment_settings_section_*.xml, so the five
             that are not shown are never built (each has previews, shaders and dozens of rows). -->
        <LinearLayout
            android:id="@+id/settingsSectionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </ScrollView>
</LinearLayout>
