<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude domain="sharedpref" path="ApiKeysPrefsStore.xml" />
    <exclude domain="sharedpref" path="MainAppPrefs.xml" />
    <exclude domain="database" path="chat_database" />
    <exclude domain="database" path="chat_database-shm" />
    <exclude domain="database" path="chat_database-wal" />
    <exclude domain="database" path="chat_database-journal" />
    <!-- Leftovers from before these copies moved to noBackupFilesDir. A backup can run before the next open. -->
    <exclude domain="database" path="chat_database.pre_sqlcipher" />
    <exclude domain="database" path="chat_database.encrypting" />
    <exclude domain="database" path="chat_database.encrypt_ok" />
    <!-- Recovered/unreadable copies that could not enter noBackupFilesDir. -->
    <exclude domain="database" path="chat_db_hold" />
    <exclude domain="sharedpref" path="code_mode_secrets.xml" />
    <!-- One-shot open nonces and shade ids; a restore must not unlock or collide. -->
    <exclude domain="sharedpref" path="code_away_open_tokens.xml" />
    <exclude domain="sharedpref" path="code_away_notif_ids.xml" />
</full-backup-content>
