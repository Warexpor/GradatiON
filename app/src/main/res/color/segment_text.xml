<?xml version="1.0" encoding="utf-8"?>
<!-- Glass segmented control label: ink on the glass thumb, muted elsewhere -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/xai_tertiary" />
    <item android:state_checked="true" android:color="@color/xai_ink" />
    <item android:state_pressed="true" android:color="@color/xai_body" />
    <item android:color="@color/xai_mute" />
</selector>
