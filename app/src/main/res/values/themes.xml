<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- xAI: dark-canvas only (no light mode) -->
    <style name="Theme.Grokion" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/xai_canvas</item>
        <item name="colorSurface">@color/xai_canvas</item>
        <item name="colorOnSurface">@color/xai_body</item>
        <item name="colorPrimary">@color/xai_ink</item>
        <item name="colorOnPrimary">@color/xai_canvas</item>
        <item name="colorPrimaryContainer">@color/xai_canvas_soft</item>
        <item name="colorOnPrimaryContainer">@color/xai_ink</item>
        <item name="colorSecondary">@color/xai_mute</item>
        <item name="colorOnSecondary">@color/xai_canvas</item>
        <item name="colorSecondaryContainer">@color/xai_canvas_mid</item>
        <item name="colorOnSecondaryContainer">@color/xai_ink</item>
        <item name="colorTertiary">@color/xai_tertiary</item>
        <item name="colorOnTertiary">@color/xai_canvas</item>
        <item name="colorTertiaryContainer">@color/xai_canvas_soft</item>
        <item name="colorOnTertiaryContainer">@color/xai_ink</item>
        <item name="android:textColorPrimary">@color/xai_ink</item>
        <item name="android:textColorSecondary">@color/xai_mute</item>
        <item name="android:textColorHighlight">@color/xai_text_highlight</item>
        <item name="colorControlActivated">@color/xai_ink</item>
        <item name="colorControlNormal">@color/xai_mute</item>
        <item name="android:colorControlNormal">@color/xai_mute</item>
        <!-- Kill Material ripple; SVG burst via selectable backgrounds -->
        <item name="colorControlHighlight">@android:color/transparent</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <item name="android:selectableItemBackground">@drawable/bg_press_svg</item>
        <item name="selectableItemBackground">@drawable/bg_press_svg</item>
        <item name="android:selectableItemBackgroundBorderless">@drawable/bg_press_svg_borderless</item>
        <item name="selectableItemBackgroundBorderless">@drawable/bg_press_svg_borderless</item>
        <item name="materialButtonStyle">@style/Widget.Grokion.Button</item>
        <item name="materialIconButtonStyle">@style/Widget.Grokion.IconButton</item>
        <item name="borderlessButtonStyle">@style/Widget.Grokion.Button.Text</item>
        <item name="colorOutline">@color/xai_canvas_mid</item>
        <item name="colorOutlineVariant">@color/xai_hairline</item>
        <item name="colorSurfaceVariant">@color/xai_canvas_soft</item>
        <item name="colorOnSurfaceVariant">@color/xai_mute</item>
        <item name="colorSurfaceContainer">@color/xai_canvas_soft</item>
        <item name="colorSurfaceContainerHigh">@color/xai_canvas_card</item>
        <item name="colorSurfaceContainerHighest">@color/xai_canvas_mid</item>
        <item name="colorSurfaceContainerLow">@color/xai_canvas</item>
        <item name="colorSurfaceContainerLowest">@color/xai_canvas</item>
        <item name="colorError">@color/xai_error</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:colorBackground">@color/xai_canvas</item>
        <item name="android:statusBarColor">@color/xai_canvas</item>
        <item name="android:navigationBarColor">@color/xai_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/xai_ink</item>
        <item name="colorAccent">@color/xai_ink</item>
        <item name="materialAlertDialogTheme">@style/CustomMaterialAlertDialogTheme</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <style name="Widget.Grokion.Button" parent="Widget.Material3.Button">
        <item name="rippleColor">@color/press_ripple_none</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:foreground">@drawable/bg_press_svg</item>
    </style>

    <style name="Widget.Grokion.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="rippleColor">@color/press_ripple_none</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:foreground">@drawable/bg_press_svg</item>
    </style>

    <style name="Widget.Grokion.Button.SettingsRow" parent="Widget.Grokion.Button.Text">
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/xai_ink</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="iconGravity">start</item>
        <item name="iconPadding">16dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">@color/xai_ink</item>
        <item name="rippleColor">@color/press_ripple_none</item>
    </style>

    <style name="Widget.Grokion.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="rippleColor">@color/press_ripple_none</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:foreground">@drawable/bg_press_svg_borderless</item>
    </style>

    <style name="Widget.Grokion.IconButton.Filled" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="rippleColor">@color/press_ripple_none</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:foreground">@drawable/bg_press_svg_borderless</item>
    </style>

    <!-- Model-picker toggle chips — checked tick must follow ink (not Material black) -->
    <style name="Widget.Grokion.Button.OutlinedToggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="checkedIconTint">@color/xai_ink</item>
        <item name="iconTint">@color/xai_ink</item>
        <item name="android:textColor">@color/xai_ink</item>
        <item name="strokeColor">@color/xai_hairline</item>
        <item name="backgroundTint">@color/toggle_background_selector</item>
        <item name="rippleColor">@color/press_ripple_none</item>
        <item name="checkedIconVisible">false</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Grokion.ToggleButton</item>
    </style>

    <!-- Model picker filter chips — compact horizontal pills -->
    <style name="Widget.Grokion.Button.FilterChip" parent="Widget.Grokion.Button.OutlinedToggle">
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="Widget.Grokion.ModelCapabilityBadge" parent="Widget.AppCompat.TextView">
        <item name="android:background">@drawable/bg_capability_badge</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/xai_mute</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="ThemeOverlay.Grokion.ToggleButton" parent="">
        <item name="colorPrimary">@color/xai_ink</item>
        <item name="colorOnPrimary">@color/xai_canvas</item>
        <item name="colorOnContainer">@color/xai_ink</item>
        <item name="colorOnSurface">@color/xai_ink</item>
        <item name="colorSecondary">@color/xai_ink</item>
        <item name="colorOnSecondary">@color/xai_canvas</item>
    </style>

    <style name="Widget.App.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/button_tint</item>
        <item name="buttonIconTint">@color/button_icon_tint</item>
    </style>

    <style name="CustomMaterialAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog.Centered">
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="shapeAppearanceMediumComponent">@style/XaiShapeCard</item>
        <item name="android:textColorPrimary">@color/xai_body</item>
        <item name="colorPrimary">@color/xai_ink</item>
        <item name="colorSurface">@color/xai_canvas_card</item>
        <item name="android:background">@color/xai_canvas_card</item>
        <item name="materialAlertDialogTitleTextStyle">@style/CustomDialogTitleText</item>
        <item name="materialAlertDialogBodyTextStyle">@style/CustomDialogBodyText</item>
        <item name="android:colorAccent">@color/xai_ink</item>
        <item name="buttonBarPositiveButtonStyle">@style/XaiDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/XaiDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/XaiDialogButton</item>
    </style>

    <style name="XaiShapeCard" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="XaiShapePill" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">999dp</item>
    </style>

    <style name="ff" parent="XaiShapeCard" />

    <style name="XaiDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/xai_ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="XaiDialogButton.Destructive" parent="XaiDialogButton">
        <item name="android:textColor">@color/xai_error</item>
    </style>

    <style name="CustomDialogTheme" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorSurface">@color/xai_canvas_card</item>
        <item name="android:background">@color/xai_canvas_card</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:textColorPrimary">@color/xai_body</item>
        <item name="colorPrimary">@color/xai_ink</item>
        <item name="materialAlertDialogTitleTextStyle">@style/CustomDialogTitleText</item>
        <item name="materialAlertDialogBodyTextStyle">@style/CustomDialogBodyText</item>
    </style>

    <style name="CustomDialogBodyText" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/xai_body</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <style name="CustomDialogTitleText" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/xai_ink</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="RoundedCornersDialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowBackground">@drawable/rounded_dialog_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorAccent">@color/xai_ink</item>
        <item name="colorPrimary">@color/xai_ink</item>
        <item name="colorSurface">@color/xai_canvas_card</item>
    </style>

    <style name="MyEditTextTheme" parent="ThemeOverlay.AppCompat.Dark">
        <item name="colorControlActivated">@color/xai_ink</item>
        <item name="colorControlNormal">@color/xai_hairline</item>
        <item name="android:textColorHint">@color/xai_mute</item>
    </style>

    <style name="Xai.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_box_stroke_selector</item>
        <item name="hintTextColor">@color/xai_mute</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxBackgroundColor">@color/xai_canvas_soft</item>
    </style>

    <!-- Brand wordmark for history header — Iceland (display) -->
    <style name="GrokionBrandWordmark" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/iceland_regular</item>
        <item name="fontFamily">@font/iceland_regular</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Theme.Grokion.AIFix" parent="Theme.Grokion">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <style name="ShapeAppearance.Grokion.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.Grokion.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearance">@style/ShapeAppearance.Grokion.BottomSheet</item>
        <item name="backgroundTint">@color/xai_canvas_card</item>
    </style>

    <style name="ThemeOverlay.Grokion.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Grokion.BottomSheet</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:colorBackground">@color/xai_canvas_card</item>
    </style>
</resources>
