    <string name="code_settings_title">Code mode</string>
    <string name="code_settings_intro">Drive Claude Code, Codex, OpenCode and other coding agents running on your own machines. Agents run there; this phone only steers them, reads their work and approves what they do.</string>
    <string name="code_settings_show_tab">Show Code tab</string>
