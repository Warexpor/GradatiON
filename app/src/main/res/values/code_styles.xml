<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compact pill for in-card actions (approval cards, onboarding). Tonal, never a solid ink slab. -->
    <style name="Widget.Gradation.Code.Button" parent="Widget.Gradation.Button.Tonal">
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <!-- The action we expect: same tonal pill, ink rim so it leads without turning into a white slab -->
    <style name="Widget.Gradation.Code.Button.Lead">
        <item name="strokeColor">@color/xai_ink</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="TextAppearance.Gradation.Code.Mono" parent="">
        <item name="android:fontFamily">@font/atkinsonhyperlegiblemono_regular</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/xai_mute</item>
    </style>

    <!-- Composer pills (agent, folder, approvals): same capsule as the chat model pill -->
    <style name="Widget.Gradation.Code.Pill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">@drawable/bg_model_pill</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxWidth">140dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/xai_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:fontFamily">@font/app_sans</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:drawableTint">@color/xai_body</item>
    </style>

    <style name="Widget.Gradation.Code.Step" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/xai_ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/app_sans</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>
