<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compact pill for in-card actions (approval cards, onboarding). Tonal, never a solid ink slab. -->
    <style name="Widget.Gradation.Code.Button" parent="Widget.Gradation.Button.Tonal">
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <!-- The action we expect: same tonal pill, ink rim so it leads without turning into a white slab -->
    <style name="Widget.Gradation.Code.Button.Lead">
        <item name="strokeColor">@color/xai_ink</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="TextAppearance.Gradation.Code.Mono" parent="">
        <item name="android:fontFamily">@font/atkinsonhyperlegiblemono_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/xai_mute</item>
    </style>

    <!-- Mono caption in Code chrome (paths, status, counts). A style, not a textAppearance, and
         both font attributes: the theme sets AppCompat's fontFamily, which outranks the platform one. -->
    <style name="Widget.Gradation.Code.MonoLine" parent="">
        <item name="android:fontFamily">@font/atkinsonhyperlegiblemono_regular</item>
        <item name="fontFamily">@font/atkinsonhyperlegiblemono_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/xai_mute</item>
    </style>

    <!-- Composer pills (agent, folder, approvals): same capsule as the chat model pill -->
    <style name="Widget.Gradation.Code.Pill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">@drawable/bg_model_pill</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxWidth">200dp</item>
        <item name="android:ellipsize">middle</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/xai_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:fontFamily">@font/app_sans</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:drawableTint">@color/xai_body</item>
    </style>

    <style name="Widget.Gradation.Code.Step" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/xai_ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/app_sans</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- Hairline between onboarding steps, starting under the text rather than the number -->
    <style name="Widget.Gradation.Code.StepRule" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">40dp</item>
        <item name="android:background">@color/xai_hairline</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- One agent in the onboarding strip: its mark in a lit disc, for show only -->
    <style name="Widget.Gradation.Code.AgentMark" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_code_disc</item>
        <item name="android:padding">10dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/xai_ink</item>
    </style>
</resources>
