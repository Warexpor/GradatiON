<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Server-type pill in the Local server sheet: the same glass capsule as the model filter chips -->
    <style name="Widget.Gradation.ServerChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/xai_body</item>
        <item name="android:background">@drawable/bg_model_pill</item>
        <item name="android:stateListAnimator">@animator/glass_press</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
