<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="GlassMaterial">
        <attr name="glassCornerRadius" format="dimension" />
        <attr name="glassTint" format="color" />
        <attr name="glassBlurRadius" format="dimension" />
        <attr name="glassBottomEdgeOnly" format="boolean" />
        <attr name="glassEdgeAlpha" format="float" />
        <!-- Bend content at the rim (liquid glass lens, API 33+) -->
        <attr name="glassLens" format="boolean" />
        <!-- Spring up, lean and glow under the finger -->
        <attr name="glassInteractive" format="boolean" />
        <!-- Soft floating shadow -->
        <attr name="glassElevation" format="dimension" />
    </declare-styleable>
    <declare-styleable name="GlassDrawable">
        <attr name="glassTint" />
        <attr name="glassCornerRadius" />
        <attr name="glassInteractive" />
        <!-- Round only the top corners (bottom sheets) -->
        <attr name="glassTopOnly" format="boolean" />
        <!-- Centered capsule of this height instead of filling the bounds -->
        <attr name="glassDiameter" format="dimension" />
        <!-- Tint while selected or checked (control tiles, "on" states); makes the drawable stateful -->
        <attr name="glassSelectedTint" format="color" />
        <!-- Fill turns solid when live blur is off (battery saver). False for small buttons. -->
        <attr name="glassOpaqueWithoutBlur" format="boolean" />
    </declare-styleable>
    <declare-styleable name="AmbientBackgroundView">
        <!-- Force a style (previews); unset = follow Settings > Appearance > Background -->
        <attr name="ambientStyle" format="enum">
            <enum name="off" value="0" />
            <enum name="drift" value="1" />
            <enum name="flow" value="2" />
            <enum name="adaptive" value="3" />
            <enum name="photo" value="4" />
        </attr>
        <!-- Animate at the style's low frame rate (default true); false = one static frame -->
        <attr name="ambientAnimated" format="boolean" />
        <!-- Strength multiplier on the tuned default (1 = default) -->
        <attr name="ambientIntensity" format="float" />
    </declare-styleable>
</resources>
