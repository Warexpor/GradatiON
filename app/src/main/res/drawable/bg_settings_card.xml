<?xml version="1.0" encoding="utf-8"?>
<!-- Grouped inset card (iOS settings style): static control glass, frosted solid on battery saver.
     Tint only, no live blur of its own, so a screen full of cards adds no blur layers. -->
<drawable xmlns:app="http://schemas.android.com/apk/res-auto"
    class="io.github.stardomains3.oxproxion.GlassDrawable"
    app:glassTint="@color/glass_control_tint"
    app:glassCornerRadius="16dp" />
