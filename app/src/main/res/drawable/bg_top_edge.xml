    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/grad_top_edge"
        android:centerColor="@color/top_edge_mid"
        android:centerY="0.68"
        android:endColor="@color/grad_fade_clear" />
</shape>
