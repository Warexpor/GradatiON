<?xml version="1.0" encoding="utf-8"?>
<!-- Send: ink circle with a faint vertical gradient; recessed gray when disabled -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/xai_send_disabled" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/grad_send_top"
                android:endColor="@color/grad_send_bottom" />
        </shape>
    </item>
</selector>
