<?xml version="1.0" encoding="utf-8"?>
<!-- Top-bar chips (model, mode): gradient capsule with hairline -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/grad_chip_top"
        android:endColor="@color/grad_chip_bottom" />
    <stroke android:width="1dp" android:color="@color/xai_hairline" />
    <corners android:radius="999dp" />
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="2dp"
        android:bottom="4dp" />
</shape>
