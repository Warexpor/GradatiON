<?xml version="1.0" encoding="utf-8"?>
<!-- Model list row: same wash as the composer's model popover; the model in use stays lit. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="60"
    android:exitFadeDuration="220">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/popover_row_pressed" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/popover_row_selected" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
