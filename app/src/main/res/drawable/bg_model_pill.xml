<?xml version="1.0" encoding="utf-8"?>
<!-- Composer model pill: tonal capsule matching the round composer actions; darkens while pressed/open -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="90"
    android:exitFadeDuration="160">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/model_pill_pressed" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/model_pill_pressed" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/xai_send_disabled" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</selector>
