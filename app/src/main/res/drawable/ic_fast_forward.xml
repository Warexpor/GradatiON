<?xml version="1.0" encoding="utf-8"?>
<!-- RP "Continue": two outline chevrons, same weight as ic_send. The pair spans 6 to 19: centred on the
     viewport, then half a unit right, since a right-pointing shape reads left of its true centre. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M6,6.5 L11.5,12 L6,17.5 M13.5,6.5 L19,12 L13.5,17.5" />
</vector>
