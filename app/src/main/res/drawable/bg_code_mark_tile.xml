<?xml version="1.0" encoding="utf-8"?>
<!-- Agent mark on a session row: a recessed key, lit while the session is working or waiting -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/code_tile_lit" />
            <stroke android:width="1dp" android:color="@color/xai_hairline" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/code_tile_fill" />
            <stroke android:width="1dp" android:color="@color/xai_hairline" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
