<?xml version="1.0" encoding="utf-8"?>
<!-- Popover row: the selected row sits on a tonal pill (Grok's highlighted "Fast"); pressed rows flash it -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="80"
    android:exitFadeDuration="200">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/popover_row_pressed" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/popover_row_selected" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>
