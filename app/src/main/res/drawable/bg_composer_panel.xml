<?xml version="1.0" encoding="utf-8"?>
<!-- Composer: raised panel with a soft top-to-bottom gradient and a hairline edge -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/grad_panel_top"
        android:endColor="@color/grad_panel_bottom"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/xai_hairline" />
    <corners android:radius="26dp" />
</shape>
